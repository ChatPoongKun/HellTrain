            "더는 당신의 죄악에 동조하지 않겠습니다.",
            { resolve = function(context) return { forceMood("rejection") } end }
        ),

        agnes_center_in_prayer = card(
            "agnes_center_in_prayer", "짧게 기도하다", "recovery", {},
            "::tag[recovery]:: 십자가를 쥐고 기도를 되뇌며, 닥쳐오는 부정한 유혹에 저항합니다.",
            { "저항을 2 회복합니다.", "현재 무드가 혼란 또는 순응이면 대신 저항을 3 회복합니다." },
            "가슴 앞의 십자가를 두 손으로 감싸 쥐고 눈을 감은 채, 떨리는 입술로 조용히 기도를 읊조린다.",
            "주여... 부디 저를 굳건히 지켜주소서... 이 부정한 죄악에 굴복하지 않게 하소서...",
            {
                resolve = function(context)
                    local amount = (context.mood == "confusion" or context.mood == "compliance") and 3 or 2
                    return { recoverResistance(amount) }
                end,
            }
        ),

        agnes_lower_eyes = card(
            "agnes_lower_eyes", "시선을 내리고 호흡 고르기", "response", {},
            "::tag[response]:: 시선을 바닥으로 내리고 호흡을 가다듬어 달아오른 감각을 냉각합니다.",
            { "냉각 3." },
            "시선을 바닥으로 내린 채 깊게 숨을 들이쉬고 내쉬며 차분함을 되찾는다.",
            "마음을 가라앉히자... 감각의 유혹에 휩쓸려선 안 돼.",
            { resolve = function(context) return { cool(context, 3) } end }
        ),

        agnes_firm_rebuke = card(
            "agnes_firm_rebuke", "단호하게 잘못을 지적하다", "response", {},
            "::tag[response]:: 부드러운 표정을 거두고 상대의 음란한 행동이 죄임을 단호히 밝힙니다.",
            { "반발 3." },
            "엄숙한 표정으로 상대의 행동이 명백한 죄악임을 단호하게 지적한다.",
            "온유함과 죄를 묵인하는 것은 다릅니다.",
            { resolve = function(context) return { backlash(context, 3) } end }
        ),

        agnes_invoke_conscience = card(
            "agnes_invoke_conscience", "양심에 호소하다", "exposure", {},
            "::tag[exposure]:: 상대의 눈을 바라보며 스스로 부끄러움을 느끼도록 차분히 압박합니다.",
            { "플레이어가 은폐를 2 잃습니다.", "현재 무드가 의심 또는 거부이면 대신 은폐를 3 잃습니다." },
            "분노 대신 깊은 슬픔을 담은 눈으로 상대를 바라보며 스스로의 양심을 돌아보라 타이른다.",
            "부끄러움을 알 수 있는 마음이 아직 남아있기를...",
            {
                resolve = function(context)
                    local amount = (context.mood == "suspicion" or context.mood == "rejection") and 3 or 2
                    return { loseStealth(amount) }
                end,
            }
        ),

        agnes_seek_station_staff = planCard(
            "agnes_seek_station_staff", "역무원을 찾는 시선", "exposure",
            "::tag[exposure]:: 역무원이나 도움을 청할 사람을 찾으며 다음 움직임을 기다리는 ::tag[plan]::을 배치합니다.",
            { "지속 2턴, 충전 1.", "다음 플레이어 카드가 선언되면 은폐를 3 잃습니다." },
            "주변 표지판과 플랫폼 쪽을 살피며 도움을 청할 이의 위치를 확인한다.",
            "다시 손을 대려 한다면 주저 없이 도움을 요청하겠어.",
            "상대가 움직이자 즉시 주변을 향해 도움을 요청하며 상황을 드러낸다.",
            "이 부정한 행동을 다른 사람들에게 알리겠습니다.",
            2, 1,
            function(context, event) return { loseStealth(3, "plan") } end
        ),
    },
}
