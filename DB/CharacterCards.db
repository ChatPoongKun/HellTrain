            {
                resolve = function(context)
                    local amount = (context.mood == "confusion" or context.mood == "compliance") and 4 or 2
                    return { recoverResistance(amount) }
                end,
            }
        ),

        agnes_lower_eyes = card(
            "agnes_lower_eyes", "시선을 내리고 호흡 고르기", "evade", {},
