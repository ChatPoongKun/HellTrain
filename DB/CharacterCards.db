            "가슴팍의 십자가를 쥔 채 상대의 눈을 흔들림 없이 바라보며 양심의 고통을 일깨워, 음험한 은폐를 무너뜨리는 행동입니다.",
            {
                actorAction = "가슴에 품은 성경과 십자가를 상대의 눈앞에 드러내며, 영혼 깊은 곳의 양심을 일깨우듯 흔들림 없는 눈빛으로 응시한다.",
                actorThought = "당신의 양심은 정녕 이 죄악 앞에 침묵하고 있습니까? 스스로의 타락을 직시하십시오.",
            },
            function(context, event)
                return { loseStealth((context.mood == "suspicion" or context.mood == "rejection") and 3 or 2) }
            end
        ),
        agnes_seek_station_staff = planCard(
            "agnes_seek_station_staff", "역무원 시선 탐색", { "response", "exposure" }, { "다음 유린 카드 선언 시 은폐 피해 3. 반발 1." }, 2, "violation",
            "플랫폼과 열차 순찰 승무원의 위치를 눈여겨보며 대기하다가, 치한이 비열하게 덮쳐올 때 일제히 도움을 요청할 ::tag[plan]::을 배치합니다.",
            {
                planPlaced = {
                    actorAction = "열차가 정차할 플랫폼 방향을 눈여겨보며, 승강장에 서 있을 역무원과 경찰관의 위치를 미리 가늠해 둔다.",
                    actorThought = "다음 역 문이 열리는 순간, 즉시 도움을 청하겠습니다. 그 더러운 손길이 이어질 시간은 얼마 남지 않았습니다.",
                },
                planTriggered = {
                    actorAction = "열차 문 쪽을 향해 몸을 홱 틀며 역무원님! 여기 치한이 있습니다! 하고 단호하게 외친다.",
                    actorThought = "더 이상의 방관은 죄악을 키울 뿐입니다. 공권력의 심판 앞에 당신의 죄를 고백하십시오!",
                },
            },
            function(context, event)
                return { loseStealth(3), backlash(context, 1) }
            end
        ),
    },
}
