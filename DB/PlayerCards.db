add({
    id = "pc_r01_cost_upgrade",
    name = "노련한 밀착",
    rarity = "rare",
    roles = { "pressure", "violation" },
    cost = 0,
    damage = 3,
    rules = { "농락 1." },
    description = "::tag[pressure]:: ::tag[violation]:: 아무런 기척도 없이 등 뒤로 스며들어, 단단해진 자지를 엉덩이에 깊숙이 파묻고 손바닥 가득 주무르는 노련한 치한 테크닉입니다.",
    actorAction = "한 치의 군더더기 없는 움직임으로 사각에 밀착해, 발기한 자지를 엉덩이골 사이에 깊숙이 찔러 넣고 양손으로 풍만한 엉덩이 살결을 손바닥 가득 감싸 쥐어 주무른다.",
    resolve = function(context) return { manipulate(context, 1) } end,
})

add({
    id = "pc_r02_damage_upgrade",
    name = "허벅지 안쪽",
    rarity = "rare",
    roles = { "pressure", "violation" },
    cost = 1,
    damage = 4,
    rules = { "농락 1." },
    description = "::tag[pressure]:: ::tag[violation]:: 손가락을 하의 틈새로 깊숙이 밀어 넣어, 사타구니 안쪽의 가장 여리고 뜨거운 살결을 손바닥으로 감싸 쥐는 행동입니다.",
    actorAction = "손을 사타구니 안쪽 가장 깊숙한 곳까지 거침없이 밀어 넣어, 손바닥 전체로 뜨겁고 보드라운 살결을 감싸 쥐며 가랑이 틈새를 지그시 밀어 올린다.",
    resolve = function(context) return { manipulate(context, 1) } end,
})

add({
    id = "pc_r03_mood_upgrade",
    name = "자지 끈적마찰",
    rarity = "rare",
    roles = { "pressure", "violation" },
    cost = 1,
    damage = 3,
    rules = { "농락 2." },
    description = "::tag[pressure]:: ::tag[violation]:: 터질 듯한 자지를 엉덩이골 틈새에 완벽히 끼워 넣고, 은근슬쩍 집요하게 골반을 돌려 단번에 음란하게 타락시킵니다.",
    actorAction = '"뒤에서 닿는 이 뜨거운 거... 어떤 모양인지 다 느껴지죠?♥" 팽창한 자지를 엉덩이골에 끼워 맞추고, 골반을 묵직하고 끈적하게 돌리며 사정없이 문질러댄다.',
    resolve = function(context) return { manipulate(context, 2) } end,
})

add({
    id = "pc_r04_recovery_upgrade",
    name = "완벽한 사각",
    rarity = "rare",
    roles = { "deception", "pressure" },
    cost = 0,
    damage = 0,
    rules = { "은폐 5 회복.", "농락 1." },
    description = "::tag[deception]:: ::tag[pressure]:: 인파 속에 완벽히 녹아들어 흔적을 지우면서, 목덜미에 입을 맞추고 농락을 이어가는 최상급 기만 기술입니다.",
    actorAction = "주변 승객들의 시야에서 완벽히 몸을 숨기며 등 뒤로 밀착한다. 목덜미의 보드라운 살결에 입술을 살포시 대고 뜨거운 숨을 불어넣으며 다음 손길을 준비한다.",
    resolve = function(context) return { recoverStealth(5), manipulate(context, 1) } end,
})

add({
    id = "pc_r05_recovery_damage",
    name = "은밀한 가슴",
    rarity = "rare",
    roles = { "deception", "violation" },
    cost = 0,
    damage = 2,
    rules = { "은폐 4 회복." },
    description = "::tag[deception]:: ::tag[violation]:: 그 누구에게도 들키지 않는 완벽한 사각에서 옷 위로 가슴을 받쳐 올려 부드럽게 매만지며 은폐와 피해를 동시에 거두는 행동입니다.",
    actorAction = "시선은 태연하게 정면을 향한 채, 사각에서 뻗은 손으로 옷 너머 풍만한 가슴의 말랑한 곡선을 아래에서부터 받쳐 올려 손바닥 가득 부드럽게 주무르고 싹 빠져나온다.",
    resolve = function() return { recoverStealth(4) } end,
})

add({
    id = "pc_r06_force_conditional",
    name = "협박의 속삭임",
    rarity = "rare",
    roles = { "pressure", "violation" },
    cost = 1,
    damage = 2,
    rules = { "의심 또는 거절이면 턴 종료 무드를 무시로 강제 변경." },
    description = "::tag[pressure]:: ::tag[violation]:: \"소리치면 여기서 다 보여줄 뿐이야\"라며 귓가에 위협하듯 속삭여, 거센 저항과 의심을 얼어붙게 만드는 강제 무드 행동입니다.",
    actorAction = '"소리 내서 사람들을 부르면... 당신이 어떤 꼴로 당하고 있었는지 다 알게 될 텐데? 얌전히 있는 게 좋을 텐데♥" 귓가에 낮게 읊조리며 허리를 거칠게 낚아챈다.',
    resolve = function(context) if negative(context.mood) then return { forceMood("ignore") } end return {} end,
})

add({
    id = "pc_r07_force_unconditional",
    name = "이성붕괴 비순",
    rarity = "rare",
    roles = { "pressure", "violation" },
    cost = 1,
    damage = 1,
    rules = { "턴 종료 무드를 혼란으로 강제 변경." },
    description = "::tag[pressure]:: ::tag[violation]:: 가랑이 중심부의 급소를 불시에 손바닥으로 감싸 쥐어, 전신에 오싹한 쾌락의 번개를 떨어뜨려 머릿속을 새하얗게 비우는 행동입니다.",
    actorAction = "손을 단숨에 다리 사이로 찔러 넣어 옷 너머 은밀한 돌기를 손가락 끝으로 강하게 비틀어 짓누른다! 한순간에 머릿속의 이성을 끊어버리는 찌릿한 쾌감을 강제로 주입한다.",
    resolve = function() return { forceMood("confusion") } end,
})

add({
    id = "pc_r08_payoff_remove",
    name = "함락의 절정",
    rarity = "rare",
    roles = { "violation" },
    mechanisms = { "remove" },
    cost = 5,
    damage = 7,
    rules = { "순응이면 추가 저항 피해 5.", "사용 후 소멸." },
    description = "::tag[remove]:: ::tag[violation]:: 순응하여 저항을 잃은 몸을 덮치듯 밀착해, 옷 속으로 손을 깊숙이 파묻고 온몸을 끈적하게 유린하는 궁극의 피니셔 카드입니다.",
    actorAction = '"더 이상 참을 필요 없어요... 그대로 녹아내려요♥" 순응해 힘이 풀린 몸을 뒤에서 완전히 덮쳐 안고, 옷 속으로 양손을 찔러 넣어 가슴과 엉덩이의 풍만한 곡선을 손바닥 가득 감싸 쥐고 탐스럽게 주무르며 맹렬하게 유린한다.',
    resolve = function(context) if context.mood == "compliance" then return { damage(5) } end return {} end,
})

add({
    id = "pc_r09_payoff_insight",
    name = "심연의 능욕",
    rarity = "rare",
    roles = { "pressure", "violation" },
    mechanisms = { "insight" },
    cost = 4,
    damage = 6,
    rules = { "혼란이면 추가 저항 피해 2.", "순응이면 추가 저항 피해 5 후 냉각 1.", "이 카드 때문에 발동할 상대 계획을 억제." },
    description = "::tag[insight]:: ::tag[pressure]:: ::tag[violation]:: 상대의 방어를 완벽히 간파하고 가랑이와 엉덩이에 자지와 손길을 동시에 박아넣어 저항을 산산조각 냅니다.",
    actorAction = "상대의 방어 의도를 완벽히 읽고 그 틈새로 파고든다. 단단한 자지를 엉덩이골에 빈틈없이 처박고, 손가락으로 가랑이 중심부를 깊숙이 짓눌러 온몸이 무너지도록 희롱한다.",
    resolve = function(context) if context.mood == "compliance" then return { damage(5), cool(context, 1) } end if context.mood == "confusion" then return { damage(2) } end return {} end,
})

add({
    id = "pc_r10_chain_draw",
    name = "절정충동 자극",
    rarity = "rare",
    cardType = "chain",
    roles = { "violation" },
    cost = 1,
    damage = 1,
    rules = { "선택 단계에 카드를 1장 즉시 뽑음." },
    description = "::tag[chain]:: ::tag[violation]:: 살결의 떨림을 손끝으로 매만지며, 다음 순번에 퍼부을 쾌락의 연타를 준비하는 연계 드로우 행동입니다.",
    actorAction = "등허리를 손끝으로 둥글게 매만지며 미세하게 떨려오는 보드라운 피부의 감촉을 음미한다. 다음에 퍼부을 더 야하고 잔인한 손길을 머릿속에 장전한다.",
    selectionPreview = { effects = { { id = "draw_one", op = "draw_cards", target = "player", amount = 1 } } },
})

add({
    id = "pc_r11_choice_compliance",
    name = "암컷본능 조교",
    rarity = "rare",
    roles = { "pressure", "violation" },
    cost = 0,
    damage = 2,
    rules = { "다음 중 하나를 선택: 농락 1 / 순응 토큰 1개 추가." },
    description = "::tag[pressure]:: ::tag[violation]:: 귓가에 음란한 조롱을 불어넣거나 가랑이를 완전히 밀착해, 스스로 몸을 내맡기도록 조교하는 강력한 선택형 행동입니다.",
    effectChoices = {
        {
            id = "manipulate_one",
            label = "본능 자극",
            description = "농락 1.",
            actorAction = '"안 만져주면 이제 아쉽죠? 몸이 이렇게 솔직하게 달아올랐는데♥" 귓불을 잘근잘근 핥으며 엉덩이에 자지를 끈질기게 비빈다.',
        },
        {
            id = "compliance_one",
            label = "완전 조교",
            description = "순응 토큰 1개 추가.",
            actorAction = '"그냥 다 포기하고 느껴봐요... 자, 기분 좋게 해줄게요♥" 허리를 감싸 쥐고 자신의 발기한 가랑이에 골반을 빈틈없이 맞물려 완전히 길들인다.',
        },
    },
    resolve = function(context) if context.effectChoiceId == "compliance_one" then return { addMood("compliance", 1, "cardChoice") } end return { manipulate(context, 1, "cardChoice") } end,
})

add({
    id = "pc_r12_plan_compliance",
    name = "유린의 늪",
    rarity = "rare",
    cardType = "plan",
    roles = { "violation" },
    cost = 3,
    damage = 0,
    rules = { "지속 3턴, 충전 2.", "순응 상태의 턴 시작에 저항 피해 6." },
    description = "::tag[plan]:: ::tag[violation]:: 순응하여 저항할 수 없게 된 몸을 품에 가두고, 턴이 시작될 때마다 자비 없는 쾌락을 쏟아붓는 극악의 ::tag[plan]:: 카드입니다.",
    placedAction = '"이제 당신은 내 손길 없이는 버틸 수 없게 될 거예요...♥" 허리를 깊숙이 끌어안고 단단해진 자지를 엉덩이골에 깊게 새겨넣듯 밀착한다.',
    triggeredAction = "순응해 힘없이 기대어오는 몸을 품에 가둔 채, 옷 너머로 가슴과 가랑이를 동시에 집요하게 감싸 쥐어 주무르며 끊임없는 절정의 지옥으로 몰아넣는다.",
    plan = { event = "turn_start", durationTurns = 3, charges = 2, trigger = function(context, event) return event.type == "turn_start" and context.mood == "compliance" end, resolve = function() return { damage(6, "plan") } end },
})

return {
    schemaVersion = 1,
    kind = "cardDatabase",
    cards = cards,
}
