local MOODS={"rejection","suspicion","ignore","confusion","compliance"}
local MI={} for i,m in ipairs(MOODS)do MI[m]=i end
local function cmd(op,target,amount,mood)local v={op=op,target=target,cause="cardEffect"}if amount then v.amount=amount end if mood then v.mood=mood end return v end
local function dmg(n)return cmd("damage_resistance","character",n)end
local function rec(n)return cmd("recover_stealth","player",n)end
local function draw(n)return cmd("draw_cards","player",n)end
local function addm(m,n)return cmd("add_mood_token","character",n,m)end
local function remm(m,n)return cmd("remove_mood_token","character",n,m)end
local function force(m)return cmd("force_mood","character",nil,m)end
local function adj(m,d)return MOODS[math.max(1,math.min(5,(MI[m]or 3)+d))]end
local function manip(c,n)return addm(adj(c.mood,1),n)end
local function back(c,n)return addm(adj(c.mood,-1),n)end
local function calm(c,n)return remm(adj(c.mood,-1),n)end
local function neg(m)return m=="rejection"or m=="suspicion"end
local function pos(m)return m=="confusion"or m=="compliance"end
local function moved(c,d)local p=c.history and c.history.previousTurn if type(p)~="table"then return false end local a,b=MI[p.startMood],MI[p.endMood]return a and b and(b-a)*d>0 or false end
local cards={}
local function choice(id,label,description,actorAction,resolve)return{id=id,label=label,description=description,actorAction=actorAction,resolve=resolve}end
local function add(s)
 local t=s.cardType or"action";local v={id=s.id,owner="player",name=s.name,rarity=s.rarity,draftStyle=s.style,description=s.description,cardType=t,roles=s.roles,mechanisms=s.mechanisms or{},base={stealthCost=s.cost,resistanceDamage=s.damage or 0},rules=s.rules}
 if t=="plan"then v.mechanismData={plan=s.plan};v.narration={planPlaced={actorAction=s.placed},planTriggered={actorAction=s.triggered}}else v.narration={play={actorAction=s.actorAction or s.choices[1].actorAction}}end
 local choiceEffects={}
 for _,c in ipairs(s.choices or{})do choiceEffects[c.id]=c.resolve;c.resolve=nil end
 v.resolve=s.resolve
 if v.resolve==nil and next(choiceEffects)~=nil then v.resolve=function(context)return choiceEffects[context.effectChoiceId](context)end end
 v.canPlay=s.canPlay;v.effectChoices=s.choices;v.selectionPreview=s.preview;v.afterNextPlayerCard=s.followup;v.planOperation=s.planOp;v.removeIfUnplayed=s.removeIfUnplayed;cards[s.id]=v
end

-- 포식자: 직접 피해와 빠른 연계
add{id="pc_predator_001",name="사타구니 밀착",rarity="common",style="predator",cost=1,damage=4,roles={"violation"},rules={"저항 피해 4."},description="단단하게 발기한 앞섶을 엉덩이골 사이에 밀착시키고 허리를 강하게 비벼 깊은 쾌감을 주입합니다.",actorAction="열차 반동을 틈타 등 뒤로 파고들어 팽창한 앞섶을 엉덩이골 사이에 끼우고 골반을 묵직하게 밀어붙인다."}
add{id="pc_predator_002",name="가슴 움켜쥐기",rarity="common",style="predator",cost=2,damage=4,roles={"violation"},rules={"저항 15 이상이면 추가 피해 2."},description="가슴을 손바닥 가득 움켜쥐고 방어 의지가 굳건할수록 더 강한 자극으로 저항을 꺾습니다.",actorAction="풍만한 가슴을 옷 위로 감싸 쥐고 완강히 버티는 만큼 손아귀에 힘을 더해 깊게 주무른다.",resolve=function(c)if c.character.resistance>=15 then return{dmg(2)}end return{}end}
add{id="pc_predator_003",name="음핵 비벼대기",rarity="common",style="predator",cost=1,damage=3,roles={"violation","pressure"},rules={"이번 턴 앞서 연계 카드를 썼다면 농락 2."},description="앞선 애무에 이어 젖은 속옷 위 음핵을 집중적으로 문질러 애태우는 후속 행동입니다.",actorAction="연속 접촉으로 굳은 틈에 손을 미끄러뜨려 젖은 속옷 위 음핵을 빠르게 비벼댄다.",resolve=function(c)if(c.playerChainCardsResolved or 0)>0 then return{manip(c,2)}end return{}end}
add{id="pc_predator_004",name="사타구니 파고들기",rarity="common",style="predator",cost=3,damage=5,roles={"violation","pressure"},rules={"농락 1."},description="양다리 사이에 허벅지를 깊숙이 밀어 넣고 앞섶을 비벼 강한 쾌감으로 저항을 흐트러뜨립니다.",actorAction="두 다리 틈으로 허벅지를 밀어 넣고 뜨거운 앞섶을 젖은 사타구니에 눌러 붙인다.",resolve=function(c)return{manip(c,1)}end}
add{id="pc_predator_005",name="달아오른 귓가 공략",rarity="common",style="predator",cost=2,damage=4,roles={"violation","pressure"},rules={"진정 1. 긍정 무드면 추가 피해 2."},description="귓불을 부드럽게 스쳐 긴장을 누그러뜨린 뒤 흥분한 몸에 더 깊은 자극을 밀어붙입니다.",actorAction="귓가에 숨을 불어넣고 긴장이 풀린 엉덩이골에 앞섶을 뭉근하게 비벼댄다.",resolve=function(c)local r={calm(c,1)}if pos(c.mood)then r[#r+1]=dmg(2)end return r end}
add{id="pc_predator_006",name="성감대 집중 공략",rarity="common",style="predator",cost=2,roles={"violation"},mechanisms={"insight"},rules={"간파. 약점 공략 또는 안정 공략."},description="::tag[insight]:: 방어 태세와 남은 역의 여유를 간파해 가장 민감한 성감대를 고릅니다.",choices={choice("deep_weakness","비순 깊이 공략","피해 1. 잔여 턴 5 이상이면 추가 피해 5.","젖어 떨리는 비순 틈으로 손가락을 깊숙이 파고들어 질 입구를 자극한다.",function(c)return{dmg(c.remainingTurns>=5 and 6 or 1)}end),choice("steady_violation","가슴 애무 유린","피해 3.","가쁜 호흡을 살피며 솟은 유두와 가슴을 주물러 안정적으로 쾌락을 이어간다.",function()return{dmg(3)}end)}}
add{id="pc_predator_007",name="기습 속옷 애무",rarity="common",style="predator",cardType="chain",cost=1,damage=3,roles={"violation"},mechanisms={"remove"},rules={"사용 후 소멸."},description="::tag[remove]:: 방심한 찰나 하의 속으로 손을 넣어 속옷 위를 애무하는 소멸성 연계입니다.",actorAction="순간적으로 하의 속으로 손을 넣어 가랑이를 만진 뒤 비명이 새기 전에 거둔다."}
add{id="pc_predator_008",name="엉덩이 쓸어올리기",rarity="common",style="predator",cardType="chain",cost=1,damage=2,roles={"violation"},rules={"저항 피해 2."},description="다음 애무로 이어가기 위해 긴장한 엉덩이골과 허벅지 선을 쓸어 올리는 연계입니다.",actorAction="골반을 받치고 탄력 있는 엉덩이 아래를 감싸 위로 쓸어 올려 다음 유린의 자세를 만든다."}
add{id="pc_predator_009",name="사각지대로 몰기",rarity="common",style="predator",cardType="chain",cost=0,roles={"deception","pressure"},rules={"은폐 1 회복. 농락 1. 다음 카드 총 피해 5 이상이면 은폐 2 회복."},description="인파의 시야를 가려 은폐를 확보하고 강력한 일격을 위한 밀착 각도를 만듭니다.",actorAction="승객의 시선이 닿지 않는 사각으로 상대를 몰아 몸을 포개고 뒤이은 유린을 숨길 자세를 완성한다.",resolve=function(c)return{rec(1),manip(c,1)}end,followup={minimumDamage=5,recoverStealth=2}}
add{id="pc_predator_010",name="음란한 틈 노리기",rarity="common",style="predator",cardType="chain",cost=1,damage=1,roles={"violation"},rules={"잔여 턴 5 이상이면 선택 즉시 1장 드로우."},description="가빠진 숨과 떨리는 몸을 살피며 뒤이어 쓸 능욕 패를 보충하는 연계입니다.",actorAction="상대의 호흡을 관찰하며 앞섶을 엉덩이에 비비고 앞으로 쏟을 행위를 정리한다.",preview={when=function(c)return c.remainingTurns>=5 end,effects={ {id="predator_draw",op="draw_cards",target="player",amount=1} }}}
add{id="pc_predator_011",name="연쇄 쾌감 공략",rarity="common",style="predator",cardType="plan",cost=1,roles={"violation"},rules={"지속 3, 충전 2. 플레이어 카드 총 피해 5 이상이면 피해 3."},description="강한 자극에 반응할 때마다 민감한 위치를 미리 짚어 두는 계획입니다.",placed="가장 민감하게 반응하는 위치를 기억해 둔다.",triggered="교성을 삼키는 순간 기억한 부위를 자극해 연쇄 쾌감을 일으킨다.",plan={durationTurns=3,charges=2,event="card_resolved",side="player",trigger=function(_,e)return(e.finalResistanceDamage or 0)>=5 end,resolve=function()return{dmg(3)}end}}
add{id="pc_predator_012",name="보지 유린",rarity="rare",style="predator",cost=1,damage=5,roles={"violation"},rules={"저항 피해 5."},description="속옷을 젖혀 드러난 비순과 음핵을 손바닥 전체로 농밀하게 주물러 저항을 무너뜨립니다.",actorAction="속옷을 젖히고 맨살 가랑이에 손바닥을 밀착해 비순과 클리토리스를 집요하게 굴린다."}
add{id="pc_predator_013",name="가랑이 강제 개방",rarity="rare",style="predator",cost=1,roles={"violation","pressure"},rules={"농락 1+피해 4 또는 반발 2+피해 6."},description="가랑이를 열어젖히고 감미로운 조교와 격렬한 유린 중 하나를 선택합니다.",choices={choice("sweet_tease","허벅지 안쪽 애무","농락 1. 피해 4.","벌어진 허벅지 안쪽을 쓰다듬고 젖은 속옷 위를 둥글게 문지른다.",function(c)return{manip(c,1),dmg(4)}end),choice("violent_climax","질구 손가락 삽입","반발 2. 피해 6.","손가락을 젖은 질구 안쪽에 밀어 넣어 질벽을 자극한다.",function(c)return{back(c,2),dmg(6)}end)}}
add{id="pc_predator_014",name="옷 위에 싸기",rarity="legendary",style="predator",cost=2,damage=6,roles={"violation"},rules={"잔여 은폐 12 이하면 추가 피해 6. 미사용 시 소멸."},description="들킬 위험을 무릅쓰고 상대의 옷에 앞섶을 문질러 분출하며 기회를 놓치면 소멸합니다.",actorAction="주변 관심이 흐트러진 순간 상대에게 밀착해 옷 위에 뜨거운 흔적을 쏟고 황급히 감춘다.",resolve=function(c)if c.player.stealth<=12 then return{dmg(6)}end return{}end,removeIfUnplayed=true}

-- 조율자: 무드 이동과 긍정 무드 보상
add{id="pc_harmonizer_001",name="귓가 음란 속삭임",rarity="common",style="harmonizer",cost=1,damage=2,roles={"pressure","violation"},rules={"농락 2."},description="귓가에 은밀한 말을 속삭여 수치심과 흥분을 자극하고 상대를 수동적으로 길들입니다.",actorAction="뜨거운 숨과 음란한 말을 흘리며 고개 숙인 상대의 귓불을 입술로 스친다.",resolve=function(c)return{manip(c,2)}end}
add{id="pc_harmonizer_002",name="허리 감싸 안기",rarity="common",style="harmonizer",cost=1,damage=2,roles={"pressure","violation"},rules={"진정 2. 농락 1."},description="허리를 부드럽게 감싸 긴장을 풀면서 몸을 밀착해 쾌락 쪽으로 마음을 이끕니다.",actorAction="허리를 다정하게 감싸 떨림을 진정시키고 등을 가슴에 붙여 천천히 골반을 맞춘다.",resolve=function(c)return{calm(c,2),manip(c,1)}end}
add{id="pc_harmonizer_003",name="시선 유혹 간파",rarity="common",style="harmonizer",cost=1,damage=1,roles={"pressure","violation"},mechanisms={"insight"},rules={"간파. 농락 2 또는 혼란 토큰 1."},description="::tag[insight]:: 흔들리는 시선을 간파해 천천히 농락하거나 단숨에 혼란을 심습니다.",choices={choice("soft_control","느린 조교","농락 2.","도망치는 시선을 붙잡고 입술을 핥으며 천천히 몸을 밀착한다.",function(c)return{manip(c,2)}end),choice("confuse","노골적 유혹","혼란 토큰 1.","정면에서 음란한 손짓을 보여 사고가 멎을 만큼 유혹한다.",function()return{addm("confusion",1)}end)}}
add{id="pc_harmonizer_004",name="손끝 살결 훑기",rarity="common",style="harmonizer",cardType="chain",cost=1,damage=1,roles={"pressure","violation"},rules={"농락 1."},description="손끝으로 여린 살결을 훑어 다음 조교를 받아들일 마음의 틈을 만드는 연계입니다.",actorAction="목덜미에서 허리까지 손끝을 미끄러뜨려 몸이 다음 쾌락을 기다리게 만든다.",resolve=function(c)return{manip(c,1)}end}
add{id="pc_harmonizer_005",name="달아오른 몸 농락",rarity="common",style="harmonizer",cost=1,damage=3,roles={"pressure","violation"},rules={"직전 턴보다 긍정적이면 농락 2."},description="조금씩 마음을 연 상대의 달아오른 몸을 놓치지 않고 더 깊은 타락으로 이끕니다.",actorAction="전보다 순해진 몸을 끌어안고 가슴과 허벅지를 함께 쓸어 쾌락에 익숙해지게 한다.",resolve=function(c)if moved(c,1)then return{manip(c,2)}end return{}end}
add{id="pc_harmonizer_006",name="암컷 조교 유도",rarity="common",style="harmonizer",cost=2,roles={"pressure"},rules={"농락 3 또는 순응 토큰 2."},description="현재 마음에 맞춰 서서히 농락하거나 순응의 감각을 직접 새깁니다.",choices={choice("manipulate","부드러운 조교","농락 3.","부드러운 말과 손길을 이어 마음을 차근차근 무너뜨린다.",function(c)return{manip(c,3)}end),choice("compliance","복종 각인","순응 토큰 2.","복종을 명하고 쾌락을 허락받는 감각을 몸에 각인한다.",function()return{addm("compliance",2)}end)}}
add{id="pc_harmonizer_007",name="순응된 암컷 유린",rarity="common",style="harmonizer",cost=1,damage=3,roles={"violation","pressure"},rules={"순응이면 추가 피해 4, 반발 2."},description="순응한 몸을 거칠게 유린해 큰 쾌감을 주되 마음 깊은 반발을 다시 자극합니다.",actorAction="순순히 벌어진 몸을 거칠게 움켜쥐고 참아왔던 자극을 한꺼번에 쏟는다.",resolve=function(c)if c.mood=="compliance"then return{dmg(4),back(c,2)}end return{}end}
add{id="pc_harmonizer_008",name="녹아내린 틈 공략",rarity="common",style="harmonizer",cost=1,damage=3,roles={"violation"},rules={"직전 턴보다 긍정적이면 추가 피해 2."},description="직전보다 마음이 풀린 순간을 파고들어 달아오른 몸에 깊은 자극을 남깁니다.",actorAction="느슨해진 몸을 품에 끌어당기고 젖은 틈을 정확히 눌러 쾌감을 터뜨린다.",resolve=function(c)if moved(c,1)then return{dmg(2)}end return{}end}
add{id="pc_harmonizer_009",name="쾌락의 늪 설계",rarity="common",style="harmonizer",cardType="plan",cost=0,roles={"violation"},rules={"지속 3, 충전 2. 직전 턴보다 긍정적이면 피해 3."},description="상대가 긍정적인 쾌락으로 기울 때마다 빠져나오기 힘든 자극을 겹치는 계획입니다.",placed="쾌락을 받아들이는 순간을 놓치지 않도록 반응의 흐름을 읽는다.",triggered="마음이 쾌락 쪽으로 기울자 민감한 곳을 눌러 더 깊은 늪으로 끌어당긴다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return moved(c,1)end,resolve=function()return{dmg(3)}end}}
add{id="pc_harmonizer_010",name="최면적 밀착 조교",rarity="common",style="harmonizer",cardType="plan",cost=1,roles={"pressure"},rules={"배치 시 농락 1. 지속 4, 충전 2. 부정적으로 이동하면 농락 2."},description="반복되는 밀착과 속삭임으로 부정적인 흔들림마저 타락의 리듬으로 바꾸는 계획입니다.",placed="호흡과 골반의 움직임을 맞추며 조교의 리듬을 몸에 새긴다.",triggered="마음이 거칠게 흔들리자 익숙한 속삭임과 밀착으로 쾌락 쪽을 가리킨다.",resolve=function(c)return{manip(c,1)}end,plan={durationTurns=4,charges=2,event="turn_start",trigger=function(c)return moved(c,-1)end,resolve=function(c)return{manip(c,2)}end}}
local PAIRS={rs={"rejection","suspicion"},si={"suspicion","ignore"},ic={"ignore","confusion"},cc={"confusion","compliance"}}
local pc={}for _,x in ipairs({ {"rs","거절 → 의심"},{"si","의심 → 무시"},{"ic","무시 → 혼란"},{"cc","혼란 → 순응"} })do local id=x[1];pc[#pc+1]=choice(id,x[2],"부정 쪽 토큰 최대 2개를 긍정 쪽으로 옮깁니다.","굳은 표정과 호흡을 맞추며 마음을 한 단계 부드러운 방향으로 돌린다.",function(c)local p=PAIRS[id];local n=math.min(2,c.character.moodTokens[p[1]]or 0)if n==0 then return{}end return{remm(p[1],n),addm(p[2],n)}end)end
add{id="pc_harmonizer_011",name="마음 돌려놓기",rarity="rare",style="harmonizer",cost=0,damage=1,roles={"pressure","violation"},rules={"인접 무드 쌍의 부정 쪽 토큰 최대 2개를 긍정 쪽으로 이동."},description="인접한 두 무드 사이의 마음을 조율해 부정적인 감정을 긍정적인 쾌락으로 돌립니다.",choices=pc}
add{id="pc_harmonizer_012",name="감미로운 절정 쐐기",rarity="rare",style="harmonizer",cost=2,damage=3,roles={"violation"},rules={"긍정 무드면 추가 피해 5."},description="이미 쾌락을 받아들이는 상대에게 감미로운 절정의 쐐기를 박아 저항을 무너뜨립니다.",actorAction="흐물거리는 몸을 받치고 가장 민감한 곳을 자극해 달콤한 절정을 끌어낸다.",resolve=function(c)if pos(c.mood)then return{dmg(5)}end return{}end}
local cc={}for _,x in ipairs({ {"rs","거절·의심"},{"si","의심·무시"},{"ic","무시·혼란"},{"cc","혼란·순응"} })do local id=x[1];cc[#cc+1]=choice(id,x[2],"부정 우세면 농락 3, 긍정 우세면 피해 3, 같으면 둘 다.","맞서는 두 감정을 읽고 가장 효과적인 손길로 균형을 무너뜨린다.",function(c)local p=PAIRS[id];local a,b=c.character.moodTokens[p[1]]or 0,c.character.moodTokens[p[2]]or 0;if a>b then return{manip(c,3)}elseif b>a then return{dmg(3)}end return{manip(c,3),dmg(3)}end)end
add{id="pc_harmonizer_013",name="흔들리는 마음 공략",rarity="rare",style="harmonizer",cost=1,roles={"pressure","violation"},rules={"인접 무드 토큰 비교로 농락 3, 피해 3 또는 둘 다."},description="서로 맞서는 인접 감정을 비교해 흔들리는 마음에 가장 효과적인 자극을 가합니다.",choices=cc}
local mc={}for _,m in ipairs(MOODS)do local target=m;mc[#mc+1]=choice(m,m,"모든 무드 토큰을 2로 만들고 선택 무드에 1 추가.","모든 감각을 같은 높이로 끌어올린 뒤 선택한 감정만 증폭한다.",function(c)local r={}for _,x in ipairs(MOODS)do local n=c.character.moodTokens[x]or 0;if n<2 then r[#r+1]=addm(x,2-n)elseif n>2 then r[#r+1]=remm(x,n-2)end end r[#r+1]=addm(target,1)return r end)end
add{id="pc_harmonizer_014",name="완벽한 감각 조율",rarity="legendary",style="harmonizer",cost=3,roles={"pressure"},rules={"모든 무드 토큰을 2로 변경하고 선택 무드 토큰 1 추가."},description="모든 감각과 감정을 완벽히 조율한 뒤 원하는 무드 하나를 결정적으로 증폭합니다.",choices=mc}

-- 탐식자: 반발을 감수한 고성능과 부정 무드 탈출
add{id="pc_glutton_001",name="거친 가슴 주무름",rarity="common",style="glutton",cost=0,damage=4,roles={"violation","pressure"},rules={"반발 1."},description="가슴을 거칠게 움켜쥐어 즉각 큰 쾌감을 주는 대신 강한 반발을 부릅니다.",actorAction="옷 위 가슴을 거칠게 움켜쥐고 손가락 사이로 살이 비어져 나올 만큼 세게 주무른다.",resolve=function(c)return{back(c,1)}end}
add{id="pc_glutton_002",name="기습 엉덩이 움켜쥐기",rarity="common",style="glutton",cardType="chain",cost=0,damage=2,roles={"violation","pressure"},rules={"반발 1."},description="기습적으로 엉덩이를 움켜쥐어 공짜 쾌감을 탐하지만 반발을 남기는 연계입니다.",actorAction="방심한 순간 엉덩이를 깊게 움켜쥐고 탄력 있는 살을 한 번 세게 쥐어짠다.",resolve=function(c)return{back(c,1)}end}
add{id="pc_glutton_003",name="위험한 사각 확보",rarity="common",style="glutton",cost=0,roles={"deception","pressure"},rules={"은폐 4 회복. 반발 1. 부정 무드면 무시 토큰 2."},description="대담하게 사각을 차지해 은폐를 회복하면서 반발을 감수하고 무시로 빠질 틈을 만듭니다.",actorAction="상대를 기둥 뒤 사각으로 밀어 넣고 태연한 얼굴로 시야를 가리며 몸을 붙인다.",resolve=function(c)local r={rec(4),back(c,1)}if neg(c.mood)then r[#r+1]=addm("ignore",2)end return r end}
add{id="pc_glutton_004",name="반발 달래기",rarity="common",style="glutton",cost=1,damage=2,roles={"pressure","violation"},rules={"농락 2. 부정 무드면 진정 1."},description="거칠게 끌어낸 반발을 다독이며 다시 쾌락으로 이끌고 부정 감정을 걷어냅니다.",actorAction="거칠어진 호흡을 달래듯 허리를 쓰다듬으면서도 민감한 곳을 놓치지 않고 희롱한다.",resolve=function(c)local r={manip(c,2)}if neg(c.mood)then r[#r+1]=calm(c,1)end return r end}
add{id="pc_glutton_005",name="무심한 척 농락",rarity="common",style="glutton",cost=1,damage=1,roles={"pressure","violation"},rules={"농락 2. 직전 턴보다 긍정적이면 무시 강제."},description="태연한 얼굴로 농락을 이어가 상대가 상황을 애써 무시하도록 몰아갑니다.",actorAction="아무 일도 없다는 표정으로 손끝만 움직여 젖은 살결을 희롱하고 반응을 모른 척한다.",resolve=function(c)local r={manip(c,2)}if moved(c,1)then r[#r+1]=force("ignore")end return r end}
add{id="pc_glutton_006",name="부정 탈출 포식",rarity="common",style="glutton",cost=1,damage=1,roles={"violation"},rules={"직전 턴 시작이 부정이고 현재 무시/긍정이면 추가 피해 6."},description="거절과 의심에서 빠져나온 순간 쌓인 욕망을 한꺼번에 탐해 큰 쾌락을 뜯어냅니다.",actorAction="버티던 몸이 느슨해진 찰나를 물어뜯듯 파고들어 가장 민감한 곳을 몰아붙인다.",resolve=function(c)local p=c.history and c.history.previousTurn;if type(p)=="table"and neg(p.startMood)and(c.mood=="ignore"or pos(c.mood))then return{dmg(6)}end return{}end}
add{id="pc_glutton_007",name="거절 강요 유린",rarity="common",style="glutton",cost=2,damage=7,roles={"violation","pressure"},rules={"거절 무드 강제."},description="압도적인 자극으로 큰 피해를 주는 대신 상대를 거절 상태로 몰아붙입니다.",actorAction="상대의 의사를 무시하고 몸을 붙잡아 숨 돌릴 틈 없이 강한 자극을 쏟아붓는다.",resolve=function()return{force("rejection")}end}
add{id="pc_glutton_008",name="불온한 휴식처",rarity="common",style="glutton",cardType="plan",cost=1,roles={"deception","pressure"},rules={"지속 3, 충전 2. 턴 시작 부정 무드면 진정 2, 은폐 3 회복."},description="부정 감정이 치솟을 때 몸을 숨기고 다독여 다시 탐할 여유를 만드는 계획입니다.",placed="인파 깊숙한 사각과 상대가 진정할 호흡의 틈을 마련한다.",triggered="거절과 의심이 짙어지자 사각으로 숨고 떨림을 부드럽게 가라앉힌다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return neg(c.mood)end,resolve=function(c)return{calm(c,2),rec(3)}end}}
add{id="pc_glutton_009",name="무시로 몰아넣기",rarity="common",style="glutton",cost=1,roles={"pressure"},rules={"농락 2. 부정 무드면 무시 토큰 2."},description="끈질긴 농락으로 거절과 의심을 유지하기 지치게 해 차라리 무시하게 만듭니다.",actorAction="반응을 비웃듯 집요하게 희롱해 저항하는 것조차 피곤해지도록 만든다.",resolve=function(c)local r={manip(c,2)}if neg(c.mood)then r[#r+1]=addm("ignore",2)end return r end}
add{id="pc_glutton_010",name="탐욕의 방향 전환",rarity="common",style="glutton",cost=2,roles={"pressure"},rules={"농락 3 또는 무시 토큰 2."},description="지금 더 깊게 농락할지 상대를 무시의 안전지대로 밀어 넣을지 선택합니다.",choices={choice("devour","더 깊은 농락","농락 3.","반응을 탐욕스럽게 좇아 손과 몸을 더 깊이 밀착한다.",function(c)return{manip(c,3)}end),choice("ignore","무시 유도","무시 토큰 2.","태연하게 행위를 이어가 현실을 외면하고 무시하게 만든다.",function()return{addm("ignore",2)}end)}}
add{id="pc_glutton_011",name="한입 더 탐하기",rarity="common",style="glutton",cardType="chain",cost=0,roles={"deception"},mechanisms={"remove"},rules={"선택 즉시 1장 드로우. 사용 후 소멸."},description="::tag[remove]:: 지금 손에 든 것으로 만족하지 못하고 다음 쾌락을 즉시 탐하는 소멸성 연계입니다.",actorAction="손끝에 남은 감촉을 즐기며 곧바로 다음 먹잇감을 향해 손을 뻗는다.",preview={effects={ {id="glutton_draw",op="draw_cards",target="player",amount=1} }}}
add{id="pc_glutton_012",name="추락 뒤의 포식",rarity="rare",style="glutton",cardType="plan",cost=2,roles={"violation","deception"},rules={"지속 4, 충전 2. 직전 턴보다 부정적이면 피해 2, 은폐 4 회복."},description="감정이 부정적으로 추락한 뒤 사각을 차지하고 짧고 강하게 포식할 계획입니다.",placed="감정이 무너지는 순간 숨을 곳과 파고들 위치를 함께 살핀다.",triggered="마음이 추락한 순간 사각으로 끌어당겨 짧고 강한 쾌락을 뜯어낸다.",plan={durationTurns=4,charges=2,event="turn_start",trigger=function(c)return moved(c,-1)end,resolve=function()return{dmg(2),rec(4)}end}}
add{id="pc_glutton_013",name="위태로운 자극",rarity="rare",style="glutton",cardType="chain",cost=1,damage=3,roles={"violation","pressure"},rules={"의심 토큰 1, 거절 토큰 1."},description="들킬 듯한 자극으로 큰 쾌락을 낚아채는 대신 의심과 거절을 함께 키웁니다.",actorAction="사람들의 시선 아래 민감한 곳을 대담하게 움켜쥐어 위험과 쾌락을 함께 터뜨린다.",resolve=function()return{addm("suspicion",1),addm("rejection",1)}end}
add{id="pc_glutton_014",name="현실 외면 포식",rarity="legendary",style="glutton",cost=3,damage=3,roles={"violation","pressure"},rules={"무시 무드 강제. 이번 턴 캐릭터 행동 생략."},description="상대가 현실을 외면하도록 압도적 쾌락으로 삼키고 반격할 틈까지 빼앗습니다.",actorAction="눈과 귀를 가리듯 몸을 감싸고 감각을 쾌락으로 채워 다른 현실을 잊게 만든다.",resolve=function()return{force("ignore"),cmd("skip_actions","character")}end}

-- 기만자: 은폐 회복과 계획 조작
add{id="pc_deceiver_001",name="인파 속 손길",rarity="common",style="deceiver",cost=0,damage=1,roles={"deception","violation"},rules={"은폐 4 회복."},description="인파의 움직임에 손길을 숨겨 작은 자극과 함께 은폐를 크게 회복합니다.",actorAction="승객의 흔들림에 손을 숨기고 엉덩이 아래를 짧게 쓸어 아무 일도 없던 듯 거둔다.",resolve=function()return{rec(4)}end}
add{id="pc_deceiver_002",name="안심시키는 밀착",rarity="common",style="deceiver",cost=0,roles={"deception","pressure"},rules={"은폐 4 회복. 농락 1."},description="다정한 도움처럼 몸을 붙여 의심을 피하고 은밀한 농락을 이어갑니다.",actorAction="넘어지지 않게 받쳐주는 척 허리를 감싸고 골반을 은근히 맞대며 안심시킨다.",resolve=function(c)return{rec(4),manip(c,1)}end}
add{id="pc_deceiver_003",name="흔적 감추기",rarity="common",style="deceiver",cardType="chain",cost=0,damage=1,roles={"deception","violation"},rules={"은폐 2 회복."},description="방금 남긴 음란한 흔적을 재빨리 가리며 가벼운 접촉을 이어가는 연계입니다.",actorAction="옷매무새를 고쳐주는 척 흔적을 가리고 손끝으로 민감한 곳을 한 번 더 스친다.",resolve=function()return{rec(2)}end}
add{id="pc_deceiver_004",name="계획 앞당기기",rarity="common",style="deceiver",cardType="chain",cost=1,damage=3,roles={"violation"},rules={"플레이어 계획이 있으면 가장 오래된 계획 지속 -1, 추가 피해 4."},description="이미 깔아둔 계획의 결말을 앞당기는 대가로 지금 강한 쾌락을 끌어냅니다.",actorAction="미리 정한 동선과 자세를 한 박자 당겨 상대가 대비하기 전에 깊게 파고든다.",resolve=function(c)if c.player.planCount>0 then return{dmg(4)}end return{}end,planOp={kind="adjust",side="player",remainingTurnsDelta=-1}}
add{id="pc_deceiver_005",name="계획된 농락",rarity="common",style="deceiver",cost=0,damage=2,roles={"pressure","violation"},rules={"플레이어 계획이 있으면 농락 2, 아니면 농락 1."},description="준비된 계획이 있을수록 더 자연스럽고 깊은 농락으로 이어집니다.",actorAction="계산한 사각과 흔들림에 맞춰 손을 움직여 우연처럼 자연스럽게 몸을 희롱한다.",resolve=function(c)return{manip(c,c.player.planCount>0 and 2 or 1)}end}
add{id="pc_deceiver_006",name="낡은 계획 폐기",rarity="common",style="deceiver",cardType="chain",cost=2,roles={"deception","violation"},mechanisms={"insight"},rules={"간파. 캐릭터 계획 제거+은폐 2 또는 플레이어 계획 제거+피해 4."},description="::tag[insight]:: 오래된 계획 하나를 읽고 폐기해 즉시 다른 이익으로 바꾸는 선택 연계입니다.",choices={choice("character_plan","상대 계획 간파","가장 오래된 캐릭터 계획 제거. 은폐 2 회복.","상대가 준비한 움직임을 먼저 읽어 헛돌게 하고 흔적을 감춘다.",function()return{rec(2)}end),choice("player_plan","내 계획 청산","가장 오래된 플레이어 계획 제거. 피해 4.","오래 묵힌 계획을 즉석에서 터뜨리고 강한 자극만 남긴다.",function()return{dmg(4)}end)},planOp={byChoice={character_plan={kind="remove",side="character"},player_plan={kind="remove",side="player"}}}}
add{id="pc_deceiver_007",name="허점 역이용",rarity="common",style="deceiver",cost=0,damage=1,roles={"violation"},mechanisms={"insight"},rules={"간파. 캐릭터 계획이 있으면 추가 피해 4."},description="::tag[insight]:: 상대가 계획에 정신을 쏟는 허점을 간파해 강한 자극을 꽂습니다.",actorAction="상대가 대응을 준비하는 시선을 읽고 빈틈으로 손을 넣어 민감한 곳을 누른다.",resolve=function(c)if c.character.planCount>0 then return{dmg(4)}end return{}end}
add{id="pc_deceiver_008",name="숨겨둔 마무리",rarity="common",style="deceiver",cardType="plan",cost=2,roles={"violation"},rules={"지속 3, 충전 2. 턴 시작 은폐 15 이상이면 피해 1. 만료/명시 제거 시 피해 3."},description="충분한 은폐 속에서 조금씩 자극하고 계획이 끝날 때 숨겨둔 마무리를 터뜨립니다.",placed="작은 자극과 마지막에 터뜨릴 손길을 함께 숨겨 둔다.",triggered="시선이 비켜간 순간 준비한 작은 자극을 정확히 꽂는다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return c.player.stealth>=15 end,resolve=function()return{dmg(1)}end,exitResolve=function()return{dmg(3)}end}}
add{id="pc_deceiver_009",name="폭로 역습 장치",rarity="common",style="deceiver",cardType="plan",cost=0,roles={"violation","deception"},rules={"지속 3, 충전 1. 캐릭터 폭로 카드 해결 시 피해 4, 은폐 1 회복."},description="상대가 행위를 폭로하려는 순간 그 움직임을 이용해 역습하는 계획입니다.",placed="상대가 주변에 알리려 움직일 때 막아설 위치와 손길을 계산한다.",triggered="폭로하려 몸을 돌리는 순간 밀착하고 민감한 곳을 눌러 움직임을 끊는다.",plan={durationTurns=3,charges=1,event="card_resolved",side="character",trigger=function(_,e)for _,r in ipairs(e.roles or{})do if r=="exposure"then return true end end return false end,resolve=function()return{dmg(4),rec(1)}end}}
add{id="pc_deceiver_010",name="비싼 행동의 덫",rarity="common",style="deceiver",cardType="plan",cost=0,roles={"violation"},rules={"지속 4, 충전 2. 플레이어 카드 최종 은폐 비용 2 이상이면 피해 3."},description="큰 위험을 감수한 행동에 숨겨둔 자극이 연달아 터지도록 설계한 계획입니다.",placed="대담한 행동에 이어질 두 번째 자극의 각도를 잡는다.",triggered="위험을 감수해 파고든 순간 숨겨둔 손길까지 이어져 쾌락이 겹친다.",plan={durationTurns=4,charges=2,event="card_declared",side="player",trigger=function(_,e)return(e.finalStealthCost or 0)>=2 end,resolve=function()return{dmg(3)}end}}
add{id="pc_deceiver_011",name="비밀 패 보충",rarity="common",style="deceiver",cardType="plan",cost=1,roles={"deception"},rules={"지속 4, 충전 2. 턴 시작 1장 드로우."},description="매 턴 숨겨둔 선택지를 꺼내 다음 기만을 이어가는 장기 계획입니다.",placed="인파 사이 여러 사각에 다음에 쓸 수단을 숨겨 둔다.",triggered="새 턴이 시작되자 숨겨둔 수단 하나를 아무도 모르게 손에 넣는다.",plan={durationTurns=4,charges=2,event="turn_start",trigger=function()return true end,resolve=function()return{draw(1)}end}}
add{id="pc_deceiver_012",name="회복 위장 공세",rarity="rare",style="deceiver",cardType="plan",cost=2,roles={"violation"},rules={"지속 4, 충전 2. 한 플레이어 카드가 은폐 3 이상 회복하면 피해 4."},description="흔적을 감추는 동작 속에 공격을 숨겨 큰 은폐 회복을 강한 쾌락으로 잇습니다.",placed="몸을 숨기는 모든 동작에 은밀한 공격의 각도를 겹쳐 둔다.",triggered="흔적을 감춘 순간 상대가 안심한 틈으로 깊은 자극을 넣는다.",plan={durationTurns=4,charges=2,event="card_resolved",side="player",trigger=function(_,e)return(e.grossStealthRecovery or 0)>=3 end,resolve=function()return{dmg(4)}end}}
add{id="pc_deceiver_013",name="계획 연명",rarity="rare",style="deceiver",cardType="chain",cost=0,roles={"deception"},rules={"은폐 2 회복. 가장 오래된 플레이어 계획 지속과 충전 +1."},description="들키지 않게 숨을 고르며 가장 오래된 계획의 수명과 기회를 함께 늘립니다.",actorAction="몸을 떼어 흔적을 감추고 오래된 계획을 다시 쓸 수 있도록 타이밍을 손본다.",resolve=function()return{rec(2)}end,planOp={kind="adjust",side="player",remainingTurnsDelta=1,remainingChargesDelta=1}}
add{id="pc_deceiver_014",name="비밀 계획 즉시 실행",rarity="legendary",style="deceiver",cost=0,damage=3,roles={"violation"},mechanisms={"insight","remove"},rules={"간파. 소멸. 가장 오래된 플레이어 계획을 조건·충전 소모 없이 1회 실행."},description="::tag[insight]:: ::tag[remove]:: 가장 오래된 비밀 계획을 즉시 실행하고 흔적 없이 사라집니다.",actorAction="상대의 대응을 읽은 듯 미소 짓고 오래 숨겨둔 계획을 실행한 뒤 증거를 지운다.",planOp={kind="activate",side="player"}}

return {
    schemaVersion = 1,
    kind = "cardDatabase",
    cards = cards,
}
