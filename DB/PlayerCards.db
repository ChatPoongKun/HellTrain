            { "농락 1.", "의심 또는 거절이면 진정 1." },
            "어깨 너머로 얼굴을 들이밀어 귓바퀴에 뜨거운 숨을 헐떡이고, 허벅지로 다리 뒤를 틀어막는다. 고개를 피하려 할수록 입술을 목덜미에 문지르며 팽창한 자지를 엉덩이골 중심에 단단히 고정한다.",
            {
                resolve = function(context)
                    local commands = { manipulate(context, 1) }
                    if negative(context.mood) then commands[#commands + 1] = calm(context, 1) end
                    return commands
                end,
            }
        ),

        p020_dominate_with_gaze = card(
            "p020_dominate_with_gaze", "음탕한 시선으로 암컷 굴복시키기", { "deception", "violation" }, 0, 2, {},
            "::tag[deception]:: 노려보는 눈빛을 비웃으며, 풍만한 가슴과 젖어든 사타구니를 침 흘리듯 훑어내려 수치심으로 굴복시킵니다.",
            { "의심 또는 거절이면 은폐 4 회복." },
            "경멸 어린 시선을 비열한 미소로 받아내며, 봉긋한 가슴에서부터 애액으로 젖어 있을 허벅지 사이까지 느긋하게 시선으로 핥아내린다. 수치심에 파르르 떠는 꼴을 즐기며 다음 능욕의 손길을 준비한다.",
            { resolve = function(context) if negative(context.mood) then return { recoverStealth(4) } end return {} end }
        ),

        p021_fake_accidental_brush = card(
            "p021_fake_accidental_brush", "실수인 척 젖통과 가랑이 쓸어내리기", { "pressure", "violation" }, 0, 3, {},
            "::tag[pressure]:: 흔들림을 핑계로 손등으로 말랑한 젖통을 쓸고, 엉덩이와 축축한 가랑이 사이를 음란하게 스쳐 지나갑니다.",
            { "농락 1.", "반발 1." },
            "열차가 덜컹이는 틈을 타 손등으로 봉긋한 젖가슴을 은근슬쩍 쓸어 올리고, 비틀거리는 척 손바닥으로 탱탱한 엉덩이를 덥석 주무른다. 이어 팽창한 앞섶을 허벅지 안쪽에 진득하게 문질러 어디까지가 사고인지 혼란에 빠뜨린다.",
            { resolve = function(context) return { manipulate(context, 1), backlash(context, 1) } end }
        ),

        p024_pin_by_force = card(
            "p024_pin_by_force", "벽에 몰아넣고 강제 애무하기", { "pressure", "deception" }, 2, 0, { "remove" },
            "반항하는 손목을 벽에 부드럽게 결박하고, 버둥거리는 다리 사이에 허벅지를 끼워 넣어 축축한 보지를 끈적하게 문지르는 ::tag[pressure]:: ::tag[remove]:: 행동입니다.",
            { "의심 또는 거절일 때만 사용 가능.", "은폐 6 회복.", "진정 2.", "농락 2." },
            "도망치려는 손목을 낚아채 벽에 기대어 세우고 허리를 밀착해 끌어안는다. 버둥거리는 다리 틈으로 허벅지를 밀어 넣어, 흠뻑 젖은 속옷 위로 사타구니를 뭉근하게 비벼대며 쾌감으로 저항을 녹여버린다.",
            {
                canPlay = function(context)
                    if negative(context.mood) then return true end
                    return false, "requires_negative_mood"
                end,
                resolve = function(context) return { recoverStealth(6), calm(context, 2), manipulate(context, 2) } end,
            }
        ),

        p025_adjust_close_contact = planCard(
            "p025_adjust_close_contact", "엉덩이골에 육봉 고정 체위 잡기", { "pressure", "deception" }, 2,
            "빳빳한 자지를 엉덩이골에 단단히 물려두고, 장시간 옷 속을 농락할 수 있는 최적의 체위를 잡는 ::tag[pressure]:: ::tag[plan]::을 배치합니다.",
            { "배치 시 농락 1.", "지속 3턴, 충전 2.", "혼란 또는 순응 상태의 턴 시작에 은폐 3 회복." },
            "엉덩이에 팽창한 자지를 꽉 물린 채 발 디딤을 벌리고 골반 각도를 맞춘다. 열차가 흔들려도 자지가 엉덩이골 틈새에서 빠져나가지 않도록 완벽한 밀착 체위를 고정한다.",
            "고정된 체위를 이용해 옷 속으로 손을 찔러 넣고, 허벅지 안쪽의 부드러운 살결과 젖어든 속옷 가장자리를 농염하게 훑어 올린다.",
            {
                event = "turn_start", durationTurns = 3, charges = 2,
                trigger = function(context, event)
                    return event.type == "turn_start" and positive(context.mood)
                end,
                resolve = function(context, event) return { recoverStealth(3, "plan") } end,
            },
            { resolve = function(context) return { manipulate(context, 1) } end }
        ),

        p026_track_conflicted_arousal = planCard(
            "p026_track_conflicted_arousal", "보짓물 질척이는 가랑이 들춰내며 능욕", "violation", 0,
            "입으로는 거부하면서도 음란하게 헐떡이며 보지를 흠뻑 적시는 배덕적인 신체 반응을 캐치하는 ::tag[violation]:: ::tag[plan]::을 배치합니다.",
            { "지속 3턴, 충전 1.", "턴 시작 시 토큰 2개 이상인 무드가 둘 이상이면 저항 피해 6." },
            "입술을 깨물며 저항하면서도, 가슴이 거칠게 오르내리고 은밀한 가랑이가 젖어드는 모순된 암컷 반응을 똑똑히 눈에 새긴다.",
            "거부하는 말과 달리, 보짓물로 흥건하게 젖어 살결에 찰싹 달라붙은 속옷 자국을 짚어내며 음란하게 달아오른 흥분을 낱낱이 들춰낸다.",
            {
                event = "turn_start", durationTurns = 3, charges = 1,
                trigger = function(context, event)
                    if event.type ~= "turn_start" then return false end
                    local count = 0
                    for _, amount in pairs(context.character.moodTokens) do
                        if amount >= 2 then count = count + 1 end
                    end
                    return count >= 2
                end,
                resolve = function(context, event) return { damage(6, "plan") } end,
            }
        ),

        p027_exploit_conditioned_body = planCard(
            "p027_exploit_conditioned_body", "조교된 음핵 찌걱찌걱 괴롭히기", "violation", 3,
            "손길에 길들여져 힘이 풀린 음란한 몸의 급소를 기억하고, 무방비해질 때마다 음핵을 집요하게 ::tag[violation]::하는 ::tag[plan]::을 배치합니다.",
            { "지속 3턴, 충전 2.", "순응 상태의 턴 시작에 저항 피해 6." },
            "손길이 닿을 때마다 흠칫 떨며 벌어지는 다리 사이를 기억하고, 속옷 너머로 빳빳하게 솟은 클리토리스와 젖은 비순의 위치를 손가락 끝으로 정확히 짚어 둔다.",
            "기억해 둔 클리토리스를 젖은 속옷 위로 부드럽게 압박하며 손가락으로 좁게 비벼댄다. 길들여진 몸이 쾌감에 젖어 찌걱거리며 파르르 경련할 때마다 더욱 집요하고 달콤하게 괴롭힌다.",
            {
                event = "turn_start", durationTurns = 3, charges = 2,
                trigger = function(context, event)
                    return event.type == "turn_start" and context.mood == "compliance"
                end,
                resolve = function(context, event) return { damage(6, "plan") } end,
            }
        ),

        p028_corner_target = planCard(
            "p028_corner_target", "구석에 몰아넣고 가랑이 비비기", "pressure", 1,
            "::tag[pressure]:: 객차 구석의 막다른 벽으로 몰아붙여 다리와 골반으로 퇴로를 틀어막고, 도망칠 수 없는 완전한 능욕의 덫을 놓는 ::tag[plan]::을 배치합니다.",
