    cost = 0,
    damage = 0,
    rules = { "은폐 4 회복.", "농락 1." },
    description = "::tag[deception]:: ::tag[pressure]:: 밀리는 인파 핑계를 대며 시치미를 떼면서도, 귓가에 야릇한 뜨거운 숨결을 뿜어 농락하고 은폐를 정돈합니다.",
    actorAction = '"죄송합니다, 뒤에서 갑자기 밀려서... 괜찮으세요?♥" 공손하게 사과하는 척 얼굴을 귓가에 바짝 붙이고, 귓구멍에 뜨거운 숨을 후 불어넣으며 태연하게 자세를 바로잡는다.',
    resolve = function(context) return { recoverStealth(4), manipulate(context, 1) } end,
})

add({
    id = "pc_c20_recovery_damage",
    name = "딴청 희롱",
    rarity = "common",
    roles = { "deception", "violation" },
    cost = 0,
    damage = 1,
    rules = { "은폐 4 회복." },
    description = "::tag[deception]:: ::tag[violation]:: 시선은 허공을 바라보며 사각에서 엉덩이 밑살을 손끝으로 은밀히 매만져 은폐를 챙기고 피해를 줍니다.",
    actorAction = "무심한 표정으로 차창 밖을 응시하면서, 등 뒤로 내린 손가락 끝으로 엉덩이 밑살의 말랑한 곡선을 살짝 어루만져 매만지고 재빨리 손을 거둔다.",
    resolve = function() return { recoverStealth(4) } end,
})

add({
    id = "pc_c21_recovery_pressure",
