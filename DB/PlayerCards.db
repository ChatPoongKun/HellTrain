                        if context.character.moodTokens.suspicion > 0 then return true end
                        return false, "no_target_token"
                    end,
                },
            },
            resolve = function(context)
                local mood = context.effectChoiceId == "remove_rejection"
                    and "rejection"
                    or "suspicion"
                return {
                    {
                        op = "remove_mood_token",
                        target = "character",
                        mood = mood,
                        amount = 1,
                        cause = "cardChoice",
                    },
