    rarity = "common",
    roles = { "deception", "pressure" },
    cost = 0,
    damage = 0,
    rules = { "은폐 3 회복.", "농락 2." },
    description = "::tag[deception]:: ::tag[pressure]:: 다른 승객의 등 뒤 사각으로 몸을 교묘히 숨기며, 귓가에 끈적한 음담패설을 속삭여 상대를 음란하게 달아오르게 만듭니다.",
    actorAction = '승객들의 등 뒤 사각으로 미끄러져 들어가 모습을 감추며, 귓가에 입술을 대고 "아까 닿았던 감촉, 아직도 화끈거리죠?♥"라며 낮고 음란하게 속삭인다.',
    resolve = function(context) return { recoverStealth(3), manipulate(context, 2) } end,
})

add({
    id = "pc_c22_recovery_calm",
    name = "능청스런 거리",
    rarity = "common",
    roles = { "deception", "pressure" },
    cost = 0,
    damage = 0,
    rules = { "은폐 4 회복.", "진정 2." },
    description = "::tag[deception]:: ::tag[pressure]:: \"죄송합니다\"라며 두 손을 들고 뻔뻔하게 한 걸음 물러서서 상대의 경계심을 완전히 가라앉히고 은폐를 확보합니다.",
    actorAction = '"어라, 닿았나요? 오해하지 마세요, 흔들려서 그런 거니까요." 양손을 떼어 들며 결백한 척 물러선다. 상대가 경계를 풀고 안도하는 틈을 타 완벽한 사각을 확보한다.',
    resolve = function(context) return { recoverStealth(4), calm(context, 2) } end,
})

add({
    id = "pc_c23_recovery_conditional",
