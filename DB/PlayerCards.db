local MOODS={"rejection","suspicion","ignore","confusion","compliance"}
local MI={} for i,m in ipairs(MOODS)do MI[m]=i end
local function cmd(op,target,amount,mood)local v={op=op,target=target,cause="cardEffect"}if amount then v.amount=amount end if mood then v.mood=mood end return v end
local function dmg(n)return cmd("damage_resistance","character",n)end
local function rec(n)return cmd("recover_stealth","player",n)end
local function draw(n)return cmd("draw_cards","player",n)end
local function addm(m,n)return cmd("add_mood_token","character",n,m)end
local function remm(m,n)return cmd("remove_mood_token","character",n,m)end
local function force(m)return cmd("force_mood","character",nil,m)end
local function adj(m,d)local i=(MI[m]or 3)+d if i<1 then i=1 elseif i>5 then i=5 end return MOODS[i]end
local function manip(c,n)return addm(adj(c.mood,1),n)end
local function back(c,n)return addm(adj(c.mood,-1),n)end
local function calm(c,n)return remm(adj(c.mood,-1),n)end
local function neg(m)return m=="rejection"or m=="suspicion"end
local function pos(m)return m=="confusion"or m=="compliance"end
local function moved(c,d)local p=c.history and c.history.previousTurn if type(p)~="table"then return false end local a,b=MI[p.startMood],MI[p.endMood]return a and b and(b-a)*d>0 or false end
local function hasTime(c)return c.remainingTurns>=5 end
local cards={}
local function choice(id,label,description,actorAction,resolve,canSelect)return{id=id,label=label,description=description,actorAction=actorAction,resolve=resolve,canSelect=canSelect}end
local function add(s)
 local t=s.cardType or"action";local v={id=s.id,owner="player",name=s.name,rarity=s.rarity,draftStyle=s.style,description=s.description,cardType=t,roles=s.roles,mechanisms=s.mechanisms or{},base={stealthCost=s.cost,resistanceDamage=s.damage or 0},rules=s.rules}
 if t=="plan"then v.mechanismData={plan=s.plan};v.narration={planPlaced={actorAction=s.placed},planTriggered={actorAction=s.triggered}}else local p={actorAction=s.actorAction or s.choices[1].actorAction}if s.actorActionMet then p.conditionMet={actorAction=s.actorActionMet}end v.narration={play=p}end
 local choiceEffects={}
 for _,c in ipairs(s.choices or{})do choiceEffects[c.id]=c.resolve;c.resolve=nil end
 if s.resolve~=nil then if s.condition~=nil then v.resolve=function(c)local met=c.narrationConditionMet if met==nil then met=s.condition(c)end return s.resolve(c,met)end else v.resolve=s.resolve end elseif next(choiceEffects)~=nil then v.resolve=function(c)local met=c.narrationConditionMet if met==nil and s.condition then met=s.condition(c)end return choiceEffects[c.effectChoiceId](c,met)end end
 v.narrationCondition=s.condition;v.canPlay=s.canPlay;v.effectChoices=s.choices;v.selectionPreview=s.preview;v.afterNextPlayerCard=s.followup;v.planOperation=s.planOp;v.removeIfUnplayed=s.removeIfUnplayed;cards[s.id]=v
end

-- 포식자: 직접 피해와 빠른 연계
add{id="pc_predator_001",name="사타구니 밀착",rarity="common",style="predator",cost=1,damage=4,roles={"violation"},rules={"저항 피해 4."},description="단단하게 발기한 앞섶을 엉덩이골 사이에 밀착시키고 허리를 강하게 비벼대어 깊은 쾌감을 주입하는 직접 행동입니다.",actorAction="열차의 반동을 틈타 등 뒤로 파고들어 팽창한 앞섶을 엉덩이골 사이에 깊숙이 끼워 넣는다. 상대가 몸을 빼지 못하도록 골반을 묵직하게 밀어붙이며 옷감 너머로 뜨거운 마찰을 새겨 넣는다."}
add{id="pc_predator_002",name="가슴 움켜쥐기",rarity="common",style="predator",cost=2,damage=3,roles={"violation"},rules={"잔여 저항 15 이상이면 추가 저항 피해 2."},description="옷 위로 도드라진 가슴을 손바닥 가득 움켜쥐어 주무르고, 상대의 방어 의지가 완강할수록 손아귀에 힘을 더해 저항을 꺾어버리는 행동입니다.",actorAction="가녀린 어깨 너머로 팔을 뻗어 풍만하게 솟아오른 가슴을 옷 위로 손바닥 가득 감싸 쥐고 부드럽게 주무른다.",actorActionMet="아직 저항할 힘이 남아 완강히 버티려는 꼴을 보며 손아귀에 힘을 더해 젖살이 비틀릴 만큼 깊게 주무르고, 옷자락 너머로 빳빳하게 솟은 유두를 손가락 사이에 끼워 비틀어 교성을 삼키게 만든다.",condition=function(c)return c.character.resistance>=15 end,resolve=function(_,met)if met then return{dmg(2)}end return{}end}
add{id="pc_predator_003",name="음핵 마찰",rarity="common",style="predator",cost=1,damage=3,roles={"violation","pressure"},rules={"이번 턴에 앞서 연계 카드를 사용했다면 농락 2."},description="앞선 애무에 이어 팽팽하게 당겨진 하의 위로 도드라진 가랑이 틈새를 손바닥으로 압박하듯 문질러, 다음 쾌락으로 몰아가는 후속 행동입니다.",actorAction="굳게 모은 다리 사이로 손을 미끄러뜨려 얇은 옷감 너머로 맞닿은 가랑이 틈을 손바닥으로 빠르고 강하게 문지른다.",actorActionMet="앞선 접촉으로 몸이 굳어 있는 틈을 놓치지 않고 다리 사이로 손을 밀착해, 얇은 하의 위로 도드라진 음핵의 굴곡을 손바닥 전체로 연달아 비벼대며 달아오른 신음을 터뜨리게 만든다.",condition=function(c)return(c.playerChainCardsResolved or 0)>0 end,resolve=function(c,met)if met then return{manip(c,2)}end return{}end}
add{id="pc_predator_004",name="가랑이 침범",rarity="common",style="predator",cost=3,damage=5,roles={"violation","pressure"},rules={"농락 1."},description="양다리 사이에 허벅지를 깊숙이 밀어 넣고 발기한 앞섶을 사타구니에 바싹 비벼대어, 강한 쾌감으로 저항을 흐트러뜨리는 행동입니다.",actorAction="버티고 선 두 다리 틈새로 허벅지를 거침없이 밀어 넣어 가랑이를 강제로 벌린다. 팽창한 육봉을 속옷 너머의 여린 살결과 음순 사이에 빈틈없이 밀착시키고, 허리를 묵직하게 돌리며 옷감 너머로 뜨거운 체온과 압박을 전한다.",resolve=function(c)return{manip(c,1)}end}
add{id="pc_predator_005",name="달아오른 귓가",rarity="common",style="predator",cost=2,damage=4,roles={"violation","pressure"},rules={"진정 1. 긍정 무드면 추가 저항 피해 1."},description="목덜미에 뜨거운 숨결을 흘리고 귓불을 부드럽게 스쳐 긴장을 누그러뜨린 뒤, 이미 긍정적으로 기운 반응에는 더 깊은 자극을 밀어붙이는 행동입니다.",actorAction="어깨 위로 턱을 괴듯 바싹 다가가 달아오른 귓가에 뜨거운 숨을 천천히 불어넣으며, 긴장이 풀려 무방비해진 엉덩이골에 단단한 앞섶을 뭉근하게 비벼댄다.",actorActionMet="상대의 몸이 쾌락 쪽으로 기울어 은근히 달아오른 것을 감지하고 귓불을 농밀하게 핥아 올리며, 엉덩이골에 앞섶을 깊숙이 눌러 비벼대어 억눌린 신음을 기어이 흘리게 만든다.",condition=function(c)return pos(c.mood)end,resolve=function(c,met)local r={calm(c,1)}if met then r[#r+1]=dmg(1)end return r end}
add{id="pc_predator_006",name="성감대 직격",rarity="common",style="predator",cost=2,damage=2,roles={"violation"},mechanisms={"insight"},rules={"간파. 잔여 턴 5 이상이면 추가 저항 피해 3."},description="::tag[insight]:: 잔여 역을 간파하여 여유가 있다면 약점 부위를 한층 깊숙이 파고들어 치명적인 자극을 가하는 행동입니다.",actorAction="상대의 가쁜 호흡을 살피며 옷 위로 솟아오른 가슴과 유두를 부드럽게 주무르고, 안정적으로 쾌락의 마찰을 이어간다.",actorActionMet="남은 역이 충분함을 확인하고, 긴장으로 파르르 떨리는 다리 틈새로 손을 깊숙이 밀어 넣어 속옷 너머의 비순과 질 입구 부근을 손가락 끝으로 집요하게 자극해 저항을 무너뜨린다.",condition=hasTime,resolve=function(_,met)if met then return{dmg(3)}end return{}end}
add{id="pc_predator_007",name="기습 속옷 애무",rarity="common",style="predator",cost=0,damage=3,roles={"violation"},mechanisms={"remove"},rules={"사용 후 소멸."},description="방심한 찰나 하의 속으로 손을 깊이 찔러 넣어 속옷 위로 가랑이를 만지고 비명이 새기 전에 손을 거두는 소멸성 행동입니다.",actorAction="상대가 승객들 틈에서 한눈을 파는 찰나 하의 속으로 손을 찔러 넣어 속옷 위로 가랑이 사이를 움켜쥐듯 만진 뒤, 비명이 새어 나오기 전에 잽싸게 손을 거둔다."}
add{id="pc_predator_008",name="엉덩이 쓰다듬기",rarity="common",style="predator",cost=4,damage=6,roles={"violation"},rules={"저항 피해 6."},description="옷자락 속으로 거침없이 손을 파고들어 탄력 넘치는 맨살 엉덩이를 한 손 가득 쥐어짜듯 주무르고, 골반을 억누르며 저항을 단숨에 꺾어버리는 고위력 행동입니다.",actorAction="등 뒤로 바싹 파고들어 하의 허리춤 안쪽으로 손을 거침없이 밀어 넣는다. 손바닥에 직접 닿는 탄력 넘치고 뜨거운 맨살 엉덩이를 손아귀 가득 움켜쥐어 쫀득하게 주물러대고, 다른 한 손으로는 골반을 강하게 끌어당겨 발기한 앞섶에 빈틈없이 짓눌러 교성을 삼키게 만든다."}
add{id="pc_predator_009",name="사각지대로 몰기",rarity="common",style="predator",cardType="chain",cost=0,roles={"deception","pressure"},rules={"은폐 1 회복. 이번 턴에 다음으로 사용하는 플레이어 카드의 총 저항 피해가 5 이상이면 은폐 2 추가 회복."},description="::tag[chain]:: 인파의 시야를 가려 은폐를 확보하고, 뒤이어 가해질 강력한 일격을 숨길 수 있는 완벽한 밀착 자세를 마련하는 연계 행동입니다.",actorAction="주변 승객들의 시선이 닿지 않는 사각으로 상대를 은근슬쩍 몰아세우며 몸을 바싹 포갠다. 귓가에 아무도 보고 있지 않으니 안심하라고 은밀히 전하며, 뒤이어 가해질 유린이 들키지 않도록 안전한 자세를 완성한다.",resolve=function()return{rec(1)}end,followup={minimumDamage=5,recoverStealth=2}}
add{id="pc_predator_010",name="음란한 빈틈",rarity="common",style="predator",cardType="chain",cost=1,damage=1,roles={"violation"},rules={"잔여 턴 5 이상이면 선택 시 즉시 카드 1장 드로우."},description="::tag[chain]:: 가빠진 숨소리와 떨리는 몸놀림을 살피며 앞섶을 엉덩이에 가볍게 스치고, 뒤이어 사용할 능욕 패를 빠르게 가늠하는 연계 행동입니다.",actorAction="상대의 호흡을 관찰하며 앞섶을 엉덩이에 짧게 비비고 다음 움직임을 가늠한다.",actorActionMet="종착역까지 여유가 넘치는 것을 확인하고 앞섶을 엉덩이골에 가볍게 비비며, 앞으로 쏟아낼 온갖 음란한 행위들을 머릿속으로 차분히 골라낸다.",condition=hasTime,preview={when=hasTime,effects={ {id="predator_draw",op="draw_cards",target="player",amount=1} }}}
add{id="pc_predator_011",name="연쇄 쾌감 공략",rarity="common",style="predator",cardType="plan",cost=1,roles={"violation"},rules={"지속 3턴, 충전 2. 플레이어 카드 한 장의 총 저항 피해가 5 이상이면 저항 피해 3."},description="상대가 강한 자극에 반응할 때마다 민감한 부위의 위치를 미리 짚어 두는 ::tag[plan]::을 배치합니다.",placed="상대의 반응을 살피며 가장 민감하게 반응하는 위치를 기억해 두기로 한다.",triggered="상대가 교성을 삼키며 입술을 깨무는 순간, 기억해 둔 민감한 부위를 자극해 연쇄적인 쾌감을 일으킨다.",plan={durationTurns=3,charges=2,event="card_resolved",side="player",trigger=function(_,e)return(e.finalResistanceDamage or 0)>=5 end,resolve=function()return{dmg(3)}end}}
add{id="pc_predator_012",name="보지 유린",rarity="rare",style="predator",cost=2,damage=5,roles={"violation"},rules={"저항 피해 5."},description="하의 속 속옷을 젖혀 드러난 맨살 비순과 음핵을 손바닥 전체로 농밀하게 주물러 저항을 단숨에 무너뜨리는 행동입니다.",actorAction="하의 속 속옷을 한쪽으로 젖히고 맨살 가랑이 사이에 손바닥을 밀착한다. 도드라진 비순과 클리토리스를 손가락 마디마디로 집요하게 굴려대며, 온몸의 힘을 빼놓는다."}
add{id="pc_predator_013",name="가랑이 벌리기",rarity="rare",style="predator",cost=2,roles={"violation","pressure"},rules={"허벅지 안쪽 애무는 농락 1과 저항 피해 4. 질구 손가락 삽입은 반발 2와 저항 피해 6."},description="농락을 동반한 유린과 반발을 감수한 강한 유린 중 하나를 선택합니다.",choices={choice("sweet_tease","허벅지 안쪽 애무","농락 1. 저항 피해 4.","벌어진 허벅지 안쪽 살을 부드럽게 쓰다듬으며 속옷 위를 손가락으로 둥글게 원을 그리듯 문질러 서서히 달아오르게 만든다.",function(c)return{manip(c,1),dmg(4)}end),choice("violent_climax","질구 손가락 삽입","반발 2. 저항 피해 6.","주변의 시선도 아랑곳하지 않고 손가락을 질구 안쪽으로 단숨에 밀어 넣어 질벽을 자극하며, 반발심이 다시 치밀 만큼 격렬한 교성을 터뜨리게 한다.",function(c)return{back(c,2),dmg(6)}end)}}
add{id="pc_predator_014",name="옷 위 사정",rarity="legendary",style="predator",cost=3,damage=6,roles={"violation"},rules={"비용 지불 후 잔여 은폐 12 이하면 추가 저항 피해 6. 이번 턴에 사용하지 않으면 소멸."},description="들킬 위험을 무릅쓰고 앞섶을 대상의 옷에 문질러 뜨거운 정액을 분출합니다. 지금 타이밍을 놓치면 이 기회는 다시 오지 않습니다.",actorAction="주변 시선을 피해 상대에게 밀착하고 옷 위로 앞섶을 문질러 뜨거운 흔적을 쏟아낸다.",actorActionMet="은폐가 무너질 듯한 아슬아슬한 위험 속에서 상대를 거칠게 끌어당겨 바지 지퍼 사이로 꺼낸 빳빳한 자지를 옷에 문지르고, 뜨거운 백탁액을 옷 위로 흩뿌리며 씻을 수 없는 굴욕을 새긴다.",condition=function(c)return c.player.stealth<=12 end,resolve=function(_,met)if met then return{dmg(6)}end return{}end,removeIfUnplayed=true}

-- 조율자: 무드 이동과 긍정 무드 보상
add{id="pc_harmonizer_001",name="음란한 속삭임",rarity="common",style="harmonizer",cost=1,damage=2,roles={"pressure","violation"},rules={"농락 2."},description="귓가에 은밀하고 음란한 말을 속삭여 수치심과 흥분을 자극하고, 상대를 수동적으로 길들이는 행동입니다.",actorAction="달아오른 귓바퀴에 입술이 닿을 듯 바싹 다가가, 열차 소음에 묻히도록 나직하게 음란한 말을 흘려 넣는다. 부끄러움으로 잘게 떨리는 어깨를 손끝으로 부드럽게 쓸어내리며, 귓불에 뜨거운 숨을 천천히 불어넣어 온몸의 긴장을 녹여낸다.",resolve=function(c)return{manip(c,2)}end}
add{id="pc_harmonizer_002",name="허리 감싸 안기",rarity="common",style="harmonizer",cost=1,damage=2,roles={"pressure","violation"},rules={"진정 2. 농락 1."},description="떨리는 허리를 부드럽게 감싸 안아 경계심을 누그러뜨리고, 서서히 쾌락의 마찰에 순응하도록 이끄는 행동입니다.",actorAction="겁을 먹고 굳어버린 허리를 큰 손으로 부드럽게 감싸 쥐고 천천히 쓸어내린다. 등을 가슴에 자연스럽게 기대도록 유도하며 경계심을 녹여내고, 은근슬쩍 골반을 끌어당겨 앞섶의 온기를 엉덩이에 맞춘다.",resolve=function(c)return{calm(c,2),manip(c,1)}end}
add{id="pc_harmonizer_003",name="시선 유혹 간파",rarity="common",style="harmonizer",cost=1,damage=1,roles={"pressure","violation"},mechanisms={"insight"},rules={"간파. 느린 조교는 농락 2. 노골적 유혹은 혼란 토큰 1 추가."},description="::tag[insight]:: 농락 2와 혼란 토큰 1 추가 중 하나를 선택합니다.",choices={choice("soft_control","느린 조교","농락 2.","도망치는 시선을 붙잡고 입술을 핥으며 천천히 몸을 밀착해, 귓가에 낮은 호흡을 불어넣으며 쾌락에 기울도록 유도한다.",function(c)return{manip(c,2)}end),choice("confuse","노골적 유혹","혼란 토큰 1 추가.","상대의 당황한 시선을 빤히 마주 보며 눈앞에서 음란한 손짓을 취해, 치한의 손길을 스스로 의식하게 만들어 깊은 혼란을 심어준다.",function()return{addm("confusion",1)}end)}}
add{id="pc_harmonizer_004",name="손끝 살결 훑기",rarity="common",style="harmonizer",cardType="chain",cost=1,damage=1,roles={"pressure","violation"},rules={"농락 1."},description="::tag[chain]:: 옷자락 틈으로 드러난 여린 살결을 손끝으로 가볍게 훑으며, 다음 손길을 기다리게 만드는 연계 행동입니다.",actorAction="등 뒤에서 슬그머니 손을 뻗어 옷깃 사이로 드러난 목덜미와 쇄골 라인을 손가락 끝으로 간질이듯 쓸어내린다. 흠칫 떨며 숨을 삼키는 반응을 즐기며 다음 농락을 위한 야릇한 분위기를 조성한다.",resolve=function(c)return{manip(c,1)}end}
add{id="pc_harmonizer_005",name="달아오른 농락",rarity="common",style="harmonizer",cost=1,damage=3,roles={"pressure","violation"},rules={"직전 턴 동안 무드가 긍정적으로 이동했다면 농락 2."},description="직전보다 부드럽게 기운 분위기를 틈타 엉덩이와 허벅지를 주무르며, 마음이 순응 쪽으로 더 기울도록 이끄는 행동입니다.",actorAction="상대의 몸에서 뿜어져 나오는 뜨거운 열기를 느끼며 엉덩이 살을 부드럽게 감싸 쥔다. 점차 반항을 잊고 손길에 취해가는 기색을 놓치지 않고 빳빳한 앞섶을 엉덩이골에 밀착해 골반을 흔든다.",actorActionMet="전보다 순하게 풀어진 몸을 끌어안고 가슴과 허벅지 안쪽을 부드럽게 쓸어 올리며, 저항을 잊고 쾌락의 마찰에 익숙해지도록 깊숙이 농락한다.",condition=function(c)return moved(c,1)end,resolve=function(c,met)if met then return{manip(c,2)}end return{}end}
add{id="pc_harmonizer_006",name="암컷 조교 유도",rarity="common",style="harmonizer",cost=2,roles={"pressure"},rules={"부드러운 조교는 농락 3. 복종 각인은 순응 토큰 2 추가."},description="농락 3과 순응 토큰 2 추가 중 하나를 선택합니다.",choices={choice("manipulate","부드러운 조교","농락 3.","귓가에 입술을 대고 몸이 이렇게 솔직하게 기분 좋아하는데 버텨봤자 소용없다고 부드럽게 타일러, 마음의 벽을 차근차근 무너뜨린다.",function(c)return{manip(c,3)}end),choice("compliance","복종 각인","순응 토큰 2 추가.","가녀린 골반을 꽉 쥐고 허리를 밀착시켜, 전철의 흔들림에 맞춰 복종을 명하고 쾌락을 허락받는 감각을 몸에 짙게 각인한다.",function()return{addm("compliance",2)}end)}}
add{id="pc_harmonizer_007",name="암컷 유린",rarity="common",style="harmonizer",cost=1,damage=2,roles={"violation","pressure"},rules={"순응 무드면 추가 저항 피해 5와 반발 3."},description="이미 순응한 몸의 하의 속으로 깊숙이 손을 넣어 비순과 음핵을 농락하고, 강한 쾌감을 새기는 대신 잠잠하던 반발심까지 다시 자극하는 행동입니다.",actorAction="긴장한 몸을 붙잡고 옷 위로 가슴과 가랑이를 부드럽게 쓰다듬으며 쾌락의 온도를 살핀다.",actorActionMet="완전히 순응하여 저항을 잊은 다리 틈새로 손을 거침없이 밀어 넣는다. 조교에 녹아내려 질척하게 애액이 번진 속옷 안쪽의 맨살 비순을 손가락으로 주무르고 클리토리스를 집요하게 굴려대며, 전신을 경련케 하는 절정과 함께 깊은 반발까지 동시에 끌어낸다.",condition=function(c)return c.mood=="compliance"end,resolve=function(c,met)if met then return{dmg(5),back(c,3)}end return{}end}
add{id="pc_harmonizer_008",name="녹아내린 빈틈",rarity="common",style="harmonizer",cost=1,damage=3,roles={"violation"},rules={"직전 턴 동안 무드가 긍정적으로 이동했다면 추가 저항 피해 2."},description="경계가 풀리고 흥분이 고조되는 순간을 포착해 가슴과 엉덩이를 동시에 애무하여 저항을 무너뜨리는 행동입니다.",actorAction="점차 거부감이 옅어지며 가늘게 숨을 고르는 상대의 가슴을 등 뒤에서 부드럽게 감싸 쥔다. 한 손으로는 가슴을 쫀득하게 주무르고 하체로는 앞섶을 엉덩이골에 밀착해 안정적인 쾌락을 쏟아붓는다.",actorActionMet="전보다 긴장이 풀려 은근히 달아오른 몸을 품에 깊숙이 끌어당겨, 얇은 옷 너머로 가랑이 틈새를 집요하게 눌러대며 가쁜 교성을 터뜨리게 만든다.",condition=function(c)return moved(c,1)end,resolve=function(_,met)if met then return{dmg(2)}end return{}end}
add{id="pc_harmonizer_009",name="쾌락의 늪 설계",rarity="common",style="harmonizer",cardType="plan",cost=1,roles={"violation"},rules={"지속 3턴, 충전 2. 턴 시작 시 직전 턴 동안 무드가 긍정적으로 이동했다면 저항 피해 3."},description="상대의 마음이 쾌락 쪽으로 한 단계 기울 때마다 은밀한 성감대를 자극해 저항을 깎아내는 ::tag[plan]::을 배치합니다.",placed="허리를 끌어안고 앞섶의 각도를 맞추며, 상대의 반응이 긍정적으로 기울 때 닿을 민감한 부위의 마찰면을 미리 세팅한다.",triggered="마음이 쾌락 쪽으로 기울며 몸이 은근히 달아오르는 순간, 맞물려 있던 앞섶을 사타구니 안쪽으로 깊숙이 밀어 올려 더 깊은 쾌락의 늪으로 끌어당긴다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return moved(c,1)end,resolve=function()return{dmg(3)}end}}
add{id="pc_harmonizer_010",name="점진적 조교",rarity="common",style="harmonizer",cardType="plan",cost=1,roles={"pressure"},rules={"배치 시 농락 1. 지속 4턴, 충전 2. 턴 시작 시 직전 턴 동안 무드가 부정적으로 이동했다면 농락 2."},description="배치 즉시 농락을 가하고, 상대가 저항하거나 의심하려 할 때마다 귓가 조교로 마음을 되돌리는 ::tag[plan]::을 배치합니다.",placed="귓가에 뜨거운 숨을 불어넣으며 호흡과 골반의 움직임을 맞추어 조교의 리듬을 몸에 새긴다.",triggered="상대가 차갑게 마음을 닫으려 몸을 비틀 때마다 귓불을 부드럽게 깨물며 아무리 발버둥 쳐도 몸은 정직하게 느끼고 있다고 속삭여 마음을 다시 녹인다.",resolve=function(c)return{manip(c,1)}end,plan={durationTurns=4,charges=2,event="turn_start",trigger=function(c)return moved(c,-1)end,resolve=function(c)return{manip(c,2)}end}}
add{id="pc_harmonizer_011",name="감각 되돌리기",rarity="common",style="harmonizer",cost=0,damage=2,roles={"pressure","violation"},rules={"현재 무드에 인접한 두 무드(극단에서는 현재 무드 포함) 중 부정 쪽 토큰을 최대 2개 제거하고 긍정 쪽 토큰을 같은 수만큼 추가."},description="현재 마음 주변의 부정적인 감정을 긍정적인 쪽으로 되돌려 저항을 누그러뜨리는 행동입니다.",actorAction="굳은 표정과 거친 호흡을 다정하게 맞추며 상대의 손을 슬며시 쥐어 허벅지 위에 얹는다. 거부감과 의심으로 차오르던 마음을 차분히 녹여내며 한 단계 부드러운 방향으로 감각을 돌려놓는다.",resolve=function(c)local a=adj(c.mood,-1);local b=adj(c.mood,1);local n=math.min(2,c.character.moodTokens[a]or 0)if n==0 then return{}end return{remm(a,n),addm(b,n)}end}
add{id="pc_harmonizer_012",name="감미로운 절정",rarity="rare",style="harmonizer",cost=2,damage=2,roles={"violation"},rules={"긍정 무드면 추가 저항 피해 5."},description="이미 경계가 누그러지고 긍정적인 쾌락에 기운 상대의 성감대를 깊숙이 파고들어, 강렬한 절정으로 몰아가는 행동입니다.",actorAction="떨리는 몸을 받치고 옷 위로 가장 민감한 부위를 부드럽게 자극해 달콤한 쾌감을 끌어낸다.",actorActionMet="이미 쾌락 쪽으로 기울어 은근히 촉촉해진 살결을 확인하고 하의 속으로 손을 깊숙이 밀어 넣는다. 부드러운 비순 틈새의 클리토리스를 손가락 끝으로 끈적하게 굴려대며, 더 이상 부정하기 어려운 황홀한 절정을 터뜨린다.",condition=function(c)return pos(c.mood)end,resolve=function(_,met)if met then return{dmg(5)}end return{}end}
add{id="pc_harmonizer_013",name="흔들리는 마음",rarity="rare",style="harmonizer",cost=3,roles={"pressure","violation"},rules={"거절·의심 토큰 합이 혼란·순응 토큰 합 이상이면 농락 3, 이하면 저항 피해 3"},description="거절과 의심, 혼란과 순응으로 갈린 마음의 무게를 읽어 가장 흔들리기 쉬운 지점을 공략하는 행동입니다.",actorAction="상대의 가쁜 숨결과 미세하게 떨리는 허벅지를 살피며 귓가에 짓궂은 말을 속삭이고 손바닥으로 엉덩이를 꽉 주무른다. 거부하려 들면 농염하게 유혹하고 이미 녹아내렸다면 깊숙이 자극하여 마음을 더 끌어당긴다.",resolve=function(c)local t=c.character.moodTokens;local n=(t.rejection or 0)+(t.suspicion or 0);local p=(t.confusion or 0)+(t.compliance or 0);if n>p then return{manip(c,3)}elseif p>n then return{dmg(3)}end return{manip(c,3),dmg(3)}end}
local mc={}for _,m in ipairs(MOODS)do local target=m;mc[#mc+1]=choice(m,m,"모든 무드 토큰을 2로 만들고 선택 무드에 1 추가.","양팔로 상대를 품에 안고 귓가, 목덜미, 가슴, 가랑이를 차례로 부드럽게 훑어내린다. 수치와 흥분, 의심과 순응이 비슷한 농도로 뒤섞이도록 호흡과 손길을 맞춘 뒤, 선택한 감정만 한층 선명하게 떠오르도록 마지막 자극을 더한다.",function(c)local r={}for _,x in ipairs(MOODS)do local n=c.character.moodTokens[x]or 0;if n<2 then r[#r+1]=addm(x,2-n)elseif n>2 then r[#r+1]=remm(x,n-2)end end r[#r+1]=addm(target,1)return r end)end
add{id="pc_harmonizer_014",name="완벽한 조율",rarity="legendary",style="harmonizer",cost=4,roles={"pressure"},mechanisms={"remove"},rules={"소멸. 모든 무드 토큰 수를 2로 맞춘 뒤 선택한 무드 토큰 1 추가."},description="모든 무드 토큰을 2로 맞춘 뒤, 다섯 무드 중 하나를 선택해 그 토큰을 1 추가하는 전설의 조율 행동입니다.",choices=mc}

-- 탐식자: 반발을 감수한 고성능과 부정 무드 탈출
add{id="pc_glutton_001",name="거친 가슴 애무",rarity="common",style="glutton",cost=1,damage=4,roles={"violation","pressure"},rules={"반발 1."},description="상대의 반발을 개의치 않고 옷 위로 풍만한 가슴을 한 손 가득 덥석 움켜쥐어 주무르는 대담한 행동입니다.",actorAction="상대가 움찔거리며 몸을 빼려는 것도 아랑곳하지 않고 옷 위로 솟아오른 가슴을 거침없이 감싸 쥔다. 손아귀에 넘치도록 말랑한 젖살을 쫀득하게 주무르며 손가락 사이로 살이 비어져 나올 만큼 세게 주물러, 원망 어린 시선에도 손길을 늦추지 않는다.",resolve=function(c)return{back(c,1)}end}
add{id="pc_glutton_002",name="엉덩이 기습",rarity="common",style="glutton",cardType="chain",cost=0,damage=2,roles={"violation","pressure"},rules={"반발 1."},description="::tag[chain]:: 반발을 감수하고 탄력 넘치는 엉덩이를 덥석 주물러 다음 유린으로 몰아붙이는 연계 행동입니다.",actorAction="망설임 없이 손을 뻗어 탄력 넘치는 엉덩이 살을 한 손 가득 깊게 움켜쥐고 세게 쥐어짠다. 흠칫 놀라 돌아보려는 상대의 허리에 앞섶을 거칠게 밀착하고, 반발을 감수한 채 다음 애무로 이어갈 틈을 만든다.",resolve=function(c)return{back(c,1)}end}
add{id="pc_glutton_003",name="위험한 사각",rarity="common",style="glutton",cost=0,roles={"deception","pressure"},rules={"은폐 4 회복. 반발 1. 부정 무드면 무시 토큰 2 추가."},description="대담하게 사각을 차지해 시야와 퇴로를 가리고 은폐를 크게 회복합니다. 그 뻔뻔함은 반발을 사지만, 이미 분위기가 차갑다면 상대가 상황을 외면하도록 압박합니다.",actorAction="상대를 기둥 뒤 사각으로 밀어 넣고 태연한 얼굴로 시야를 가리며 몸을 붙인다.",actorActionMet="거절과 의심으로 날 선 상대를 기둥 뒤 사각에 몰아넣고 시야와 퇴로를 가려, 분노 어린 시선에도 아랑곳하지 않고 현실을 외면하게 만든다.",condition=function(c)return neg(c.mood)end,resolve=function(c,met)local r={rec(4),back(c,1)}if met then r[#r+1]=addm("ignore",2)end return r end}
add{id="pc_glutton_004",name="반발 달래기",rarity="common",style="glutton",cost=1,damage=2,roles={"pressure","violation"},rules={"농락 1. 부정 무드면 진정 1과 추가 농락 1."},description="차가운 거부감 속에서도 다정하게 허리를 쓰다듬으며 민감한 곳을 끈질기게 희롱해, 분노를 가라앉히고 힘을 빼앗는 행동입니다.",actorAction="거칠어진 호흡을 달래듯 허리를 쓰다듬으면서도 옷 위로 허벅지 안쪽의 민감한 살결을 놓치지 않고 희롱한다.",actorActionMet="거절과 의심으로 굳어 있는 허리를 부드럽게 다독여 긴장을 풀면서, 팽팽하게 당겨진 가랑이 틈새를 손가락으로 끈질기게 문질러 힘을 빼놓는다.",condition=function(c)return neg(c.mood)end,resolve=function(c,met)local r={manip(c,1)}if met then r[#r+1]=calm(c,1);r[#r+1]=manip(c,1)end return r end}
add{id="pc_glutton_005",name="무심한 척 농락",rarity="common",style="glutton",cost=1,damage=1,roles={"pressure","violation"},rules={"농락 2. 직전 턴 동안 무드가 긍정적으로 이동했다면 무시 무드 강제."},description="아무 일도 없다는 듯 민감한 곳을 희롱하여, 상대가 달아오른 반응마저 스스로 애써 외면하고 넘어가도록 유도하는 행동입니다.",actorAction="아무 일도 없다는 표정으로 손끝만 은근히 움직여 허벅지와 엉덩이 살결을 스치고, 상대의 당황한 반응을 모른 척한다.",actorActionMet="전보다 쾌락 쪽에 기운 반응을 보고도 태연하게 은근히 달아오른 살결을 희롱하며, 귓가에 지금 소란을 피워봤자 부끄러운 꼴만 보일 뿐이라고 나직이 속삭여 스스로 아무 일도 아니라고 외면하게 만든다.",condition=function(c)return moved(c,1)end,resolve=function(c,met)local r={manip(c,2)}if met then r[#r+1]=force("ignore")end return r end}
add{id="pc_glutton_006",name="부정 탈출 포식",rarity="common",style="glutton",cost=1,damage=2,roles={"violation"},rules={"직전 턴 시작 무드가 부정이고 현재 무드가 무시 또는 긍정이면 추가 저항 피해 5."},description="거절과 의심에서 벗어나 무방비해진 틈을 포착해, 숨겨왔던 탐욕으로 강렬한 쾌락을 뜯어내는 행동입니다.",actorAction="굶주린 듯 상대를 끌어당겨 옷 위로 엉덩이와 허벅지를 거칠게 주무르며 쾌락을 뜯어낸다.",actorActionMet="방금 전까지의 날 선 거부감이 꺾이고 무방비하게 숨을 고르는 찰나를 놓치지 않고 하의 속으로 손을 깊숙이 파고든다. 무방비하게 드러난 맨살 비순과 음핵을 손바닥 전체로 거칠게 주물러대며, 억눌러왔던 교성을 단번에 터뜨리게 만든다.",condition=function(c)local p=c.history and c.history.previousTurn return type(p)=="table"and neg(p.startMood)and(c.mood=="ignore"or pos(c.mood))end,resolve=function(_,met)if met then return{dmg(5)}end return{}end}
add{id="pc_glutton_007",name="거절 강요 유린",rarity="rare",style="glutton",cost=2,damage=7,roles={"violation","pressure"},rules={"거절 무드 강제."},description="상대가 결사적으로 거부하며 몸을 굳힐 것을 알면서도, 억지로 다리 사이를 비집고 들어가 비순을 짓누르는 거칠고 대담한 유린 행동입니다.",actorAction="상대가 분노로 이를 악물고 몸을 비틀어 밀어내려는 것을 힘으로 억누르며 하의 속으로 손을 거침없이 밀어 넣는다. 잔뜩 긴장해 굳어버린 허벅지 틈을 억지로 가르고 들어가 속옷 너머의 비순을 손바닥으로 거칠게 압박해 짓이기듯 문지르며, 치욕과 고통스러운 쾌감이 뒤섞인 비명을 억지로 삼키게 만든다.",resolve=function()return{force("rejection")}end}
add{id="pc_glutton_008",name="불온한 휴식처",rarity="common",style="glutton",cardType="plan",cost=1,roles={"deception","pressure"},rules={"지속 3턴, 충전 2. 턴 시작 시 부정 무드면 진정 2와 은폐 3 회복."},description="상대의 날 선 경계와 의심 속에서도 능숙하게 인파 뒤로 몸을 숨겨 은폐를 가다듬고 동요를 가라앉히는 ::tag[plan]::을 배치합니다.",placed="인파 깊숙한 사각과 상대가 진정할 호흡의 틈을 마련한다.",triggered="거절과 의심이 짙어지자 사각으로 몸을 숨기고 떨리는 호흡을 부드럽게 가라앉힌다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return neg(c.mood)end,resolve=function(c)return{calm(c,2),rec(3)}end}}
add{id="pc_glutton_009",name="무시로 몰기",rarity="common",style="glutton",cost=1,roles={"pressure"},rules={"농락 2. 부정 무드면 무시 토큰 2 추가."},description="상대의 반항을 비웃으며 민감한 곳을 끈질기게 희롱해, 저항을 포기하고 상황을 무시하게 만드는 행동입니다.",actorAction="상대의 반응을 비웃듯 옷 위로 엉덩이 살을 꽉 감싸 쥐며, 생각할 틈을 조금씩 빼앗는다.",actorActionMet="노려보는 상대의 귓가에 입술을 바싹 대고, 화를 내봤자 주변 사람들의 시선만 끌 뿐이라고 조용히 경고하며, 거절과 의심으로 버티는 몸을 집요하게 희롱해 저항하는 것조차 지쳐 외면하게 만든다.",condition=function(c)return neg(c.mood)end,resolve=function(c,met)local r={manip(c,2)}if met then r[#r+1]=addm("ignore",2)end return r end}
add{id="pc_glutton_010",name="탐욕의 전환",rarity="common",style="glutton",cost=2,roles={"pressure"},rules={"더 깊은 농락은 농락 3. 무시 유도는 무시 토큰 2 추가."},description="농락 3과 무시 토큰 2 추가 중 하나를 선택합니다.",choices={choice("devour","더 깊은 농락","농락 3.","상대의 반응을 탐욕스럽게 좇아 단단한 앞섶을 엉덩이에 더 깊이 밀착하고 허리를 비비며 유혹한다.",function(c)return{manip(c,3)}end),choice("ignore","무시 유도","무시 토큰 2 추가.","주변 사람들의 시선을 상기시키며 아무 일도 없었던 척 넘어가는 게 서로에게 좋을 거라며 귓가에 서늘하게 경고한다.",function()return{addm("ignore",2)}end)}}
add{id="pc_glutton_011",name="탐욕의 손길",rarity="common",style="glutton",cardType="chain",cost=0,roles={"deception"},mechanisms={"remove"},rules={"선택 시 즉시 카드 1장 드로우. 사용 후 소멸."},description="::tag[chain]:: 열차가 흔들리는 찰나의 틈을 포착해 몸을 밀착하고, 다음 유린을 펼칠 카드를 빠르게 보충하는 소멸성 연계 행동입니다.",actorAction="승객들이 쏠리는 순간을 틈타 상대의 등 뒤로 미끄러지듯 밀착하며 손끝으로 허리를 가볍게 스친다. 완벽한 사각을 확보한 뒤 머릿속으로 다음 능욕의 수를 신속하게 떠올린다.",preview={effects={ {id="glutton_draw",op="draw_cards",target="player",amount=1} }}}
add{id="pc_glutton_012",name="추락 뒤의 포식",rarity="rare",style="glutton",cardType="plan",cost=2,roles={"violation","deception"},rules={"지속 4턴, 충전 2. 턴 시작 시 직전 턴 동안 무드가 부정적으로 이동했다면 저항 피해 2와 은폐 4 회복."},description="상대의 마음이 부정적으로 추락한 순간 그 반발을 역이용해 은폐를 대폭 회복하고 저항을 깎아먹는 ::tag[plan]::을 배치합니다.",placed="감정이 무너지는 순간 숨을 곳과 파고들 위치를 함께 살핀다.",triggered="마음이 추락한 순간 사각으로 끌어당겨 흔적을 감추고 짧고 강한 쾌락을 뜯어낸다.",plan={durationTurns=4,charges=2,event="turn_start",trigger=function(c)return moved(c,-1)end,resolve=function()return{dmg(2),rec(4)}end}}
add{id="pc_glutton_013",name="위태로운 자극",rarity="rare",style="glutton",cardType="chain",cost=1,damage=3,roles={"violation","pressure"},rules={"의심 토큰 1과 거절 토큰 1 추가."},description="::tag[chain]:: 상대의 의심과 거절을 불러올 만큼 대담하게 옷 위로 가랑이를 움켜쥐고 쾌락을 주입하는 연계 행동입니다.",actorAction="들킬 위험을 무릅쓰고 사람들 시선 아래에서 상대의 다리 사이로 손을 뻗어, 팽팽하게 당겨진 가랑이 틈을 손바닥으로 거칠게 움켜쥐듯 짓누른다. 깜짝 놀라 돌아보며 의심 어린 눈빛으로 노려보는 상대의 표정을 즐기며 찌릿한 자극을 남긴다.",resolve=function()return{addm("suspicion",1),addm("rejection",1)}end}
add{id="pc_glutton_014",name="현실 외면 포식",rarity="legendary",style="glutton",cost=3,damage=2,roles={"violation","pressure"},rules={"무시 무드 강제. 이번 턴의 캐릭터 행동 생략."},description="상대가 이번 턴 꺼내 들 방어 수단을 무효화하고, 강제로 무시 상태에 빠뜨려 침묵하게 만드는 전설의 행동입니다.",actorAction="뒤에서 양팔로 상대를 감싸 차벽 앞에 바싹 세우고 귓가에 낮은 숨결을 흘려 말을 끊는다. 주변 시선을 의식해 목소리를 삼키는 순간 단단한 앞섶을 엉덩이골에 빈틈없이 밀착하고 허리를 억누르며, 당혹감과 쾌락 속에서 조용히 상황을 넘기게 만든다.",resolve=function()return{force("ignore"),cmd("skip_actions","character")}end}

-- 기만자: 은폐 회복과 계획 조작
add{id="pc_deceiver_001",name="인파 속 손길",rarity="common",style="deceiver",cost=0,damage=1,roles={"deception","violation"},rules={"은폐 4 회복."},description="붐비는 승객들 사이로 자연스럽게 몸을 섞어 의심을 지우고, 스쳐 지나가는 척 은밀하게 엉덩이를 건드리는 행동입니다.",actorAction="만원 전철의 인파 속으로 슬그머니 몸을 숨기며 상대의 시야에서 벗어난다. 비좁은 틈을 빠져나가는 척 손등으로 탱탱한 엉덩이 살을 슬쩍 쓸어내리며, 흔적도 없이 완벽한 은폐를 회복한다.",resolve=function()return{rec(4)}end}
add{id="pc_deceiver_002",name="안심시키는 밀착",rarity="common",style="deceiver",cost=0,roles={"deception","pressure"},rules={"은폐 4 회복. 농락 1."},description="사람이 밀려서 닿았을 뿐이라며 뻔뻔하게 사과하여 의심을 씻어내고, 귓가에 은밀한 농락을 남기는 행동입니다.",actorAction="양손을 가볍게 들어 올리며 승객들이 밀려와 어쩔 수 없이 닿았다고 나직하게 둘러댄다. 결백한 척 물러서면서도 귓가에는 다음엔 더 기분 좋게 해 주겠다는 짓궂은 숨결을 불어넣어 상대를 안도와 동요에 빠뜨린다.",resolve=function(c)return{rec(4),manip(c,1)}end}
add{id="pc_deceiver_003",name="흔적 감추기",rarity="common",style="deceiver",cardType="chain",cost=0,damage=1,roles={"deception","violation"},rules={"은폐 2 회복."},description="::tag[chain]:: 열차의 흔들림에 맞춰 자연스럽게 스쳐 지나가며 은폐를 정돈하고 다음 유린을 준비하는 연계 행동입니다.",actorAction="열차가 좌우로 요동치는 순간 자연스럽게 몸을 기울여 팽창한 앞섶을 엉덩이에 가볍게 스치고 지나간다. 의도치 않은 사고처럼 꾸며내며 은폐를 유지한 채 다음 동작으로 매끄럽게 연결한다.",resolve=function()return{rec(2)}end}
add{id="pc_deceiver_004",name="계획 교란",rarity="common",style="deceiver",cost=1,damage=2,roles={"violation"},rules={"플레이어와 캐릭터의 모든 계획을 제거. 제거된 계획 하나당 추가 저항 피해 2."},description="예상 밖의 변수를 터뜨려 플레이어와 캐릭터의 계획을 모두 무너뜨리고, 제거된 계획만큼 강하게 파고드는 행동입니다.",actorAction="예상 밖의 타이밍에 움직여 서로 준비해 둔 계획을 한꺼번에 어그러뜨리고, 그 틈으로 깊이 파고들어 무너진 계획만큼 옷 위로 강한 마찰을 안긴다.",resolve=function(c)local n=(c.player.planCount or 0)+(c.character.planCount or 0)if n>0 then return{dmg(n*2)}end return{}end,planOp={kind="remove_all"}}
add{id="pc_deceiver_005",name="계획된 농락",rarity="common",style="deceiver",cost=0,damage=2,roles={"pressure","violation"},rules={"플레이어 계획이 있으면 농락 2, 없으면 농락 1."},description="설치된 덫이 있다는 여유를 드러내며 귓가에 배덕적인 속삭임을 남겨 흥분을 고조시키는 행동입니다.",actorAction="열차의 흔들림에 손길을 섞어 우연한 접촉처럼 몸을 은근히 희롱한다.",actorActionMet="설치된 덫을 의식하지 못한 상대의 귓가에 입술을 바싹 대고, 아무리 경계해도 움직임은 이미 읽혔다는 사실을 나직이 상기시키며 수치심에 떨리는 목덜미와 쇄골 라인을 손끝으로 쓸어내려 서서히 쾌락에 빠져들게 만든다.",condition=function(c)return c.player.planCount>0 end,resolve=function(c,met)return{manip(c,met and 2 or 1)}end}
add{id="pc_deceiver_006",name="낡은 계획 폐기",rarity="common",style="deceiver",cardType="chain",cost=2,roles={"deception","violation"},mechanisms={"insight"},rules={"간파. 캐릭터 계획이 있을 때만 상대 계획 간파를, 플레이어 계획이 있을 때만 내 계획 청산을 선택할 수 있다. 상대 계획 간파는 은폐 2 회복 후 가장 오래된 캐릭터 계획 제거. 내 계획 청산은 저항 피해 4 후 가장 오래된 플레이어 계획 제거."},description="::tag[insight]:: ::tag[chain]:: 상대 계획을 제거하며 은폐를 회복하는 효과와 내 계획을 제거하며 피해를 주는 효과 중 하나를 선택합니다.",choices={choice("character_plan","상대 계획 간파","은폐 2 회복. 가장 오래된 캐릭터 계획 제거.","상대가 경계하며 세워둔 방어 자세의 허점을 간파해 가볍게 흘려내고, 허탈해진 틈을 타 안전하게 인파 속으로 숨어들어 흔적을 지운다.",function()return{rec(2)}end,function(c)if(c.character.planCount or 0)>0 then return true end return false,"no_character_plan"end),choice("player_plan","내 계획 청산","저항 피해 4. 가장 오래된 플레이어 계획 제거.","설치해 두었던 밀착 자세를 과감히 거두는 척, 상대의 허벅지 안쪽 살결을 손바닥으로 강하게 훑어 올리며 속옷 밴드 가장자리를 은밀히 튕겨내듯 자극해 저항을 깎아낸다.",function()return{dmg(4)}end,function(c)if(c.player.planCount or 0)>0 then return true end return false,"no_player_plan"end)},planOp={byChoice={character_plan={kind="remove",side="character"},player_plan={kind="remove",side="player"}}}}
add{id="pc_deceiver_007",name="허점 역이용",rarity="common",style="deceiver",cost=2,damage=3,roles={"violation"},mechanisms={"insight"},rules={"간파. 캐릭터 계획이 있으면 추가 저항 피해 3."},description="::tag[insight]:: 상대가 경계 태세를 갖추느라 생긴 결정적인 사각을 간파하고, 무방비해진 가슴이나 가랑이를 기습하는 행동입니다.",actorAction="상대의 시선과 호흡이 흐트러진 짧은 틈으로 손을 넣어 옷 위로 민감한 곳을 누른다.",actorActionMet="상대가 대응을 준비하는 빈틈을 포착하고 방어가 비어버린 옷 속으로 손을 깊숙이 밀어 넣는다. 솟아오른 유두와 가슴을 손바닥 가득 움켜쥐며, 허를 찔린 교성을 삼키게 만든다.",condition=function(c)return c.character.planCount>0 end,resolve=function(_,met)if met then return{dmg(3)}end return{}end}
add{id="pc_deceiver_008",name="숨겨둔 마무리",rarity="common",style="deceiver",cardType="plan",cost=2,roles={"violation"},rules={"지속 3턴, 충전 2. 턴 시작 시 은폐 15 이상이면 저항 피해 2. 만료되거나 명시적으로 제거되면 저항 피해 3."},description="높은 은폐를 유지하며 상대의 등 뒤에 서서히 다가가, 지속적인 압박과 함께 마무리 일격을 가하는 ::tag[plan]::을 배치합니다.",placed="완벽한 사각을 확보하고 상대의 엉덩이 뒤에 바싹 달라붙어, 눈치채지 못할 만큼 미세한 마찰을 시작한다.",triggered="주변의 시선이 분산된 틈을 타 빳빳한 앞섶으로 엉덩이골을 뭉근하게 밀어 올리며, 소리 없이 야금야금 경계를 느슨하게 만든다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return c.player.stealth>=15 end,resolve=function()return{dmg(2)}end,exitResolve=function()return{dmg(3)}end}}
add{id="pc_deceiver_009",name="폭로 역습 장치",rarity="common",style="deceiver",cardType="plan",cost=0,roles={"violation","deception"},rules={"지속 3턴, 충전 1. 캐릭터 폭로 카드가 해결되면 저항 피해 4와 은폐 1 회복."},description="상대가 도움을 청하거나 고발하려 할 때 억울한 피해자인 척 위장하여 상대를 역으로 몰아세우는 ::tag[plan]::을 배치합니다.",placed="주변 승객들이 보기에 완벽하게 무고한 승객처럼 보이도록 자세와 표정을 세팅하고 대기한다.",triggered="상대가 목소리를 높여 고발하려는 순간 억울한 표정으로 오히려 자기가 밀림을 당했다고 항변하여 상대를 당황시키고, 말문이 막힌 틈을 타 옷 속 은밀한 곳을 손끝으로 자극해 수치심을 안긴다.",plan={durationTurns=3,charges=1,event="card_resolved",side="character",trigger=function(_,e)for _,r in ipairs(e.roles or{})do if r=="exposure"then return true end end return false end,resolve=function()return{dmg(4),rec(1)}end}}
add{id="pc_deceiver_010",name="비싼 행동의 덫",rarity="common",style="deceiver",cardType="plan",cost=0,roles={"violation"},rules={"지속 4턴, 충전 2. 플레이어 카드의 최종 은폐 비용이 2 이상이면 저항 피해 3."},description="대담하고 큰 애무를 감행할 때마다 상대가 저항하지 못하도록 추가적인 쾌락을 덧씌우는 ::tag[plan]::을 배치합니다.",placed="큰 동작을 취해도 들키지 않을 만한 최적의 사각지대와 옷자락 틈새를 미리 계산해 둔다.",triggered="대담하게 손을 뻗어 몸을 유린할 때마다 사전에 확보한 각도를 이용해 육봉을 엉덩이에 더 깊이 밀착시키며 진한 전율을 덧씌운다.",plan={durationTurns=4,charges=2,event="card_declared",side="player",trigger=function(_,e)return(e.finalStealthCost or 0)>=2 end,resolve=function()return{dmg(3)}end}}
add{id="pc_deceiver_011",name="비밀 패 보충",rarity="common",style="deceiver",cardType="plan",cost=1,roles={"deception"},rules={"지속 4턴, 충전 2. 턴 시작 시 카드 1장 드로우."},description="전철 내의 정황과 상대의 반응을 냉철하게 관찰하며 매 턴 새로운 능욕의 수단을 확보하는 ::tag[plan]::을 배치합니다.",placed="차창의 반사와 승객들의 동선을 주시하며 다음 기회를 포착하기 위한 유리한 위치를 선점한다.",triggered="새 턴이 시작될 때마다 숨겨둔 수단 하나를 아무도 모르게 머릿속에 즉시 떠올린다.",plan={durationTurns=4,charges=2,event="turn_start",trigger=function()return true end,resolve=function()return{draw(1)}end}}
add{id="pc_deceiver_012",name="회복 위장 공세",rarity="rare",style="deceiver",cardType="plan",cost=2,roles={"violation"},rules={"지속 4턴, 충전 2. 플레이어 카드 한 장이 은폐를 3 이상 회복하면 저항 피해 4."},description="완벽하게 시치미를 떼며 은폐를 회복하는 찰나마다 상대의 몸에 배덕적인 쾌락을 새겨 넣는 ::tag[plan]::을 배치합니다.",placed="결백한 승객인 척 위장하면서도 손가락 끝은 상대의 옷자락 틈새에 걸쳐두는 이중적인 덫을 놓는다.",triggered="태연하게 시치미를 떼며 몸을 숨기는 순간, 걸쳐둔 손가락으로 속옷 너머의 음핵을 은밀히 튕겨내어 쾌락과 억울함에 몸부림치게 만든다.",plan={durationTurns=4,charges=2,event="card_resolved",side="player",trigger=function(_,e)return(e.grossStealthRecovery or 0)>=3 end,resolve=function()return{dmg(4)}end}}
add{id="pc_deceiver_013",name="계획 연장",rarity="rare",style="deceiver",cardType="chain",cost=2,roles={"deception"},rules={"모든 플레이어 계획의 남은 지속 턴과 충전을 각각 1 증가."},description="::tag[chain]:: 은폐를 정돈하고 자세를 바로잡아, 현재 가동 중인 음란한 계획의 지속 시간과 기회를 늘리는 연계 행동입니다.",actorAction="주변의 시선을 피해 몸의 중심을 살짝 바꾸며 하체 밀착을 더 단단하게 고정한다. 자세가 흐트러지지 않도록 덫의 빈틈을 꼼꼼히 메우며 다음 턴에도 계획을 이어갈 발판을 다진다.",planOp={kind="adjust",side="player",all=true,remainingTurnsDelta=1,remainingChargesDelta=1}}
add{id="pc_deceiver_014",name="비밀 계획 실행",rarity="legendary",style="deceiver",cost=0,damage=0,roles={"violation"},mechanisms={"insight"},rules={"간파. 모든 플레이어 계획을 조건과 충전을 소모하지 않고 1회 발동."},description="::tag[insight]:: 완벽한 기만술로 상대의 빈틈을 파고들어, 준비해 둔 활성 계획의 발동 효과를 충전 소모 없이 즉시 끌어내는 전설의 행동입니다.",actorAction="상대가 완전히 방심하고 결백을 믿어버린 찰나, 준비해 둔 덫의 핵심 동작을 예정보다 먼저 끌어낸다. 옷 속으로 손을 밀어 넣어 비순과 음핵 부근을 농밀하게 자극하고 앞섶을 엉덩이골에 밀착해 비벼대며, 충전을 아낀 채 계획의 쾌감을 한 차례 더 터뜨린다.",planOp={kind="activate",side="player",all=true}}

return {
    schemaVersion = 1,
    kind = "cardDatabase",
    cards = cards,
}
