    description = "::tag[deception]:: ::tag[pressure]:: 정중한 말투로 사과하며 시치미를 떼어 불리한 무드를 완화하고 대폭 은폐를 회복하는 고급 기만 행동입니다.",
    actorAction = '"차가 너무 흔들리네요, 불편하셨다면 죄송합니다." 예의 바른 태도로 물러서는 척하며, 등 뒤의 사각을 확보해 다음 손길을 뻗을 완벽한 위치를 잡는다.',
    resolve = function(context) local result = { recoverStealth(3), manipulate(context, 1) }; if negative(context.mood) then result[#result + 1] = recoverStealth(2) end return result end,
})

