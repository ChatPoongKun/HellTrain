                    unavailableText = "제거할 거절 토큰이 없습니다.",
                    canSelect = function(context)
                        if context.character.moodTokens.rejection > 0 then return true end
                        return false, "no_target_token"
                    end,
                },
                {
                    id = "remove_suspicion",
                    label = "의심 토큰 제거",
