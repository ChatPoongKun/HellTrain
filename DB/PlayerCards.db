        ),

        p031_feign_innocence = card(
            "p031_feign_innocence", "애액 묻은 손 빼며 시치미 떼기", { "pressure", "violation" }, 0, 2, {},
            "가슴과 축축한 보지를 농락하던 손을 슬그머니 빼내고 아무 일 없었다는 듯 결백한 표정으로 태연하게 버티는 ::tag[pressure]:: 행동입니다.",
            { "진정 1.", "냉각 1." },
            "애액으로 끈적해진 속옷 위를 문지르던 손가락을 천천히 빼내 주머니 속으로 숨긴다. 손끝에 묻어난 상대의 뜨거운 체온과 축축한 감촉을 은밀히 비벼대며, 얼굴에는 아무 일 없었다는 듯 뻔뻔한 무표정을 짓는다.",
            { resolve = function(context) return { calm(context, 1), cool(context, 1) } end }
        ),

        p033_catch_counter_tell = card(
            "p033_catch_counter_tell", "반격 흘려내고 가슴 주무르기", "violation", 1, 2, { "chain", "insight" },
            "::tag[violation]:: 손을 쳐내려는 움직임을 꿰뚫어 흘려내고 무방비해진 가슴을 주무르는 ::tag[insight]:: ::tag[chain]:: 행동입니다.",
            { "저항 피해 2." },
            "손을 쳐내려 어깨에 힘이 들어가는 찰나를 간파하고 손목을 부드럽게 흘려내며 반대편으로 몸을 겹친다. 가드가 풀려 무방비해진 가슴을 옷 위로 부드럽게 감싸 쥐어 주무른 뒤, 비명을 지르기도 전에 유유히 손을 뺀다."
        ),

        p034_watch_reaction = card(
            "p034_watch_reaction", "손끝에 전해지는 반응 간보기", "pressure", 0, 0, { "chain" },
            "맞닿은 하체와 손끝에 전해지는 은밀한 경련을 살펴, 음핵을 더 강하게 괴롭힐지 애태울지 선택하는 ::tag[pressure]:: ::tag[chain]:: 행동입니다.",
            { "다음 중 하나를 선택: 농락 1 / 진정 1." },
            "옷 위로 닿은 손끝에 전해지는 은밀한 경련과 허벅지의 떨림을 느끼며, 바로 더 깊이 파고들지 잠시 긴장을 늦출지 정한다.",
            {
