            }
        ),

        p029_read_trembling_knees = card(
            "p029_read_trembling_knees", "쾌감에 풀린 허벅지 틈 노리기", { "pressure", "violation" }, 0, 2, {},
            "::tag[pressure]:: 수치심과 쾌감에 무릎을 파르르 떨며 허벅지 사이의 힘을 풀기 시작하는 음란한 순간을 포착해 손을 찔러 넣습니다.",
            { "농락 1.", "무시이면 대신 농락 2." },
            "태연한 척 버티려 해도 맞붙인 무릎이 쾌락의 여운으로 파르르 떨리는 꼴을 비웃듯 내려다본다. 힘이 빠져 허벅지가 살짝 벌어지는 틈을 놓치지 않고 손등으로 여린 안쪽 살을 훑으며 속옷 안으로 손을 찔러 넣을 틈을 잰다.",
            {
