                },
            }
        ),

        p036_obscene_whisper = card(
            "p036_obscene_whisper", "귀에 대고 음란한 조롱 속삭이기", "violation", 1, 3, {},
            "::tag[violation]:: 몸을 웅크려 가리려는 귓가에 \"아래가 이렇게 흠뻑 젖었는데 가려서 뭐해?\"라며 노골적인 음담패설을 속삭여 방어를 붕괴시킵니다.",
