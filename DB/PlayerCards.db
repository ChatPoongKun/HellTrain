                planTriggered = {
                    actorAction = "미리 살핀 반응을 바탕으로 무시하는 분위기를 굳힌다.",
                },
            },
            prototype = true,
        },

        accidental_brush = {
            id = "accidental_brush",
            owner = "player",
            name = "우연한 스침",
            description = "::tag[contact]:: 행동으로 열차의 흔들림을 이용해 우연을 가장하고 저항을 낮춥니다.",
