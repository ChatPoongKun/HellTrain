local MOODS={"rejection","suspicion","ignore","confusion","compliance"}
local MI={} for i,m in ipairs(MOODS)do MI[m]=i end
local function cmd(op,target,amount,mood)local v={op=op,target=target,cause="cardEffect"}if amount then v.amount=amount end if mood then v.mood=mood end return v end
local function dmg(n)return cmd("damage_resistance","character",n)end
local function rec(n)return cmd("recover_stealth","player",n)end
local function draw(n)return cmd("draw_cards","player",n)end
local function addm(m,n)return cmd("add_mood_token","character",n,m)end
local function remm(m,n)return cmd("remove_mood_token","character",n,m)end
local function force(m)return cmd("force_mood","character",nil,m)end
local function adj(m,d)local i=(MI[m]or 3)+d if i<1 then i=1 elseif i>5 then i=5 end return MOODS[i]end
local function manip(c,n)return addm(adj(c.mood,1),n)end
local function back(c,n)return addm(adj(c.mood,-1),n)end
local function calm(c,n)return remm(adj(c.mood,-1),n)end
local function neg(m)return m=="rejection"or m=="suspicion"end
local function pos(m)return m=="confusion"or m=="compliance"end
local function moved(c,d)local p=c.history and c.history.previousTurn if type(p)~="table"then return false end local a,b=MI[p.startMood],MI[p.endMood]return a and b and(b-a)*d>0 or false end
local function hasTime(c)return c.remainingTurns>=5 end
local cards={}
local function choice(id,label,description,actorAction,resolve)return{id=id,label=label,description=description,actorAction=actorAction,resolve=resolve}end
local function add(s)
 local t=s.cardType or"action";local v={id=s.id,owner="player",name=s.name,rarity=s.rarity,draftStyle=s.style,description=s.description,cardType=t,roles=s.roles,mechanisms=s.mechanisms or{},base={stealthCost=s.cost,resistanceDamage=s.damage or 0},rules=s.rules}
 if t=="plan"then v.mechanismData={plan=s.plan};v.narration={planPlaced={actorAction=s.placed},planTriggered={actorAction=s.triggered}}else local p={actorAction=s.actorAction or s.choices[1].actorAction}if s.actorActionMet then p.conditionMet={actorAction=s.actorActionMet}end v.narration={play=p}end
 local choiceEffects={}
 for _,c in ipairs(s.choices or{})do choiceEffects[c.id]=c.resolve;c.resolve=nil end
 if s.resolve~=nil then if s.condition~=nil then v.resolve=function(c)local met=c.narrationConditionMet if met==nil then met=s.condition(c)end return s.resolve(c,met)end else v.resolve=s.resolve end elseif next(choiceEffects)~=nil then v.resolve=function(c)local met=c.narrationConditionMet if met==nil and s.condition then met=s.condition(c)end return choiceEffects[c.effectChoiceId](c,met)end end
 v.narrationCondition=s.condition;v.canPlay=s.canPlay;v.effectChoices=s.choices;v.selectionPreview=s.preview;v.afterNextPlayerCard=s.followup;v.planOperation=s.planOp;v.removeIfUnplayed=s.removeIfUnplayed;cards[s.id]=v
end

-- 포식자: 직접 피해와 빠른 연계
add{id="pc_predator_001",name="사타구니 밀착",rarity="common",style="predator",cost=1,damage=4,roles={"violation"},rules={"저항 피해 4."},description="단단하게 발기한 앞섶을 엉덩이골 사이에 밀착시키고 허리를 강하게 비벼 깊은 쾌감을 주입합니다.",actorAction="열차 반동을 틈타 등 뒤로 파고들어 팽창한 앞섶을 엉덩이골 사이에 끼우고 골반을 묵직하게 밀어붙인다."}
add{id="pc_predator_002",name="가슴 움켜쥐기",rarity="common",style="predator",cost=2,damage=4,roles={"violation"},rules={"잔여 저항 15 이상이면 추가 저항 피해 2."},description="완강히 버티는 가슴을 더 거칠게 움켜쥐어 방어 의지를 꺾습니다.",actorAction="풍만한 가슴을 옷 위로 손바닥 가득 감싸 쥐고 단단한 살을 깊게 주무른다.",actorActionMet="완강히 버티는 가슴을 거칠게 움켜쥐고 손아귀에 힘을 더해 살이 비틀릴 만큼 깊게 주무른다.",condition=function(c)return c.character.resistance>=15 end,resolve=function(_,met)if met then return{dmg(2)}end return{}end}
add{id="pc_predator_003",name="음핵 비벼대기",rarity="common",style="predator",cost=1,damage=3,roles={"violation","pressure"},rules={"이번 턴에 앞서 연계 카드를 사용했다면 농락 2."},description="앞선 애무로 흐트러진 틈을 놓치지 않고 젖은 속옷 위 음핵을 연달아 비벼댑니다.",actorAction="굳게 모은 다리 사이로 손을 미끄러뜨려 젖은 속옷 위 음핵을 빠르게 비벼댄다.",actorActionMet="앞선 애무로 흐트러진 틈을 놓치지 않고 젖은 속옷 위 음핵을 연달아 빠르게 비벼댄다.",condition=function(c)return(c.playerChainCardsResolved or 0)>0 end,resolve=function(c,met)if met then return{manip(c,2)}end return{}end}
add{id="pc_predator_004",name="사타구니 파고들기",rarity="common",style="predator",cost=3,damage=5,roles={"violation","pressure"},rules={"농락 1."},description="양다리 사이에 허벅지를 깊숙이 밀어 넣고 앞섶을 비벼 강한 쾌감으로 몸과 마음을 흐트러뜨립니다.",actorAction="두 다리 틈으로 허벅지를 밀어 넣고 뜨거운 앞섶을 젖은 사타구니에 눌러 붙인다.",resolve=function(c)return{manip(c,1)}end}
add{id="pc_predator_005",name="달아오른 귓가 공략",rarity="common",style="predator",cost=2,damage=4,roles={"violation","pressure"},rules={"진정 1. 긍정 무드면 추가 저항 피해 2."},description="귓불을 부드럽게 스쳐 긴장을 누그러뜨린 뒤 달아오른 반응을 따라 더 깊이 파고듭니다.",actorAction="귓가에 뜨거운 숨을 불어넣고 엉덩이골에 앞섶을 뭉근하게 비벼 긴장을 풀어낸다.",actorActionMet="쾌락에 달아올라 느슨해진 귓불을 핥고 엉덩이골에 앞섶을 깊게 눌러 비벼댄다.",condition=function(c)return pos(c.mood)end,resolve=function(c,met)local r={calm(c,1)}if met then r[#r+1]=dmg(2)end return r end}
add{id="pc_predator_006",name="성감대 집중 공략",rarity="common",style="predator",cost=2,roles={"violation"},mechanisms={"insight"},rules={"간파. 비순 깊이 공략은 저항 피해 1, 잔여 턴 5 이상이면 총 저항 피해 6. 가슴 애무 유린은 저항 피해 3."},description="남은 역과 상대의 반응을 살펴 깊은 약점 공략과 안정적인 유린 중 하나를 선택합니다.",actorActionMet="남은 역이 충분한 것을 확인하고 젖어 떨리는 비순 틈으로 손가락을 깊숙이 파고들어 질 입구를 집요하게 자극한다.",condition=function(c)return c.effectChoiceId=="deep_weakness"and hasTime(c)end,choices={choice("deep_weakness","비순 깊이 공략","저항 피해 1. 잔여 턴 5 이상이면 추가 저항 피해 5.","젖어 떨리는 비순 틈으로 손가락을 밀어 넣어 질 입구를 짧고 강하게 자극한다.",function(_,met)return{dmg(met and 6 or 1)}end),choice("steady_violation","가슴 애무 유린","저항 피해 3.","가쁜 호흡을 살피며 솟은 유두와 가슴을 주물러 안정적으로 쾌락을 이어간다.",function()return{dmg(3)}end)}}
add{id="pc_predator_007",name="기습 속옷 애무",rarity="common",style="predator",cardType="chain",cost=1,damage=3,roles={"violation"},mechanisms={"remove"},rules={"사용 후 소멸."},description="방심한 찰나 하의 속으로 손을 넣어 속옷 위를 애무하고 비명이 새기 전에 손을 거둡니다.",actorAction="순간적으로 하의 속으로 손을 넣어 가랑이를 만진 뒤 비명이 새기 전에 거둔다."}
add{id="pc_predator_008",name="엉덩이 쓸어올리기",rarity="common",style="predator",cardType="chain",cost=1,damage=2,roles={"violation"},rules={"저항 피해 2."},description="긴장한 엉덩이골과 허벅지 선을 아래에서 위로 길게 쓸어 올립니다.",actorAction="골반을 받치고 탄력 있는 엉덩이 아래를 감싸 위로 쓸어 올려 다음 유린의 자세를 만든다."}
add{id="pc_predator_009",name="사각지대로 몰기",rarity="common",style="predator",cardType="chain",cost=0,roles={"deception","pressure"},rules={"은폐 1 회복. 농락 1. 이번 턴에 다음으로 사용하는 플레이어 카드의 총 저항 피해가 5 이상이면 은폐 2 추가 회복."},description="인파의 시야를 가린 채 몸을 밀착하고 뒤이은 유린까지 숨길 자세를 잡습니다.",actorAction="승객의 시선이 닿지 않는 사각으로 상대를 몰아 몸을 포개고 뒤이은 유린을 숨길 자세를 완성한다.",resolve=function(c)return{rec(1),manip(c,1)}end,followup={minimumDamage=5,recoverStealth=2}}
add{id="pc_predator_010",name="음란한 틈 노리기",rarity="common",style="predator",cardType="chain",cost=1,damage=1,roles={"violation"},rules={"잔여 턴 5 이상이면 선택 시 즉시 카드 1장 드로우."},description="가빠진 숨과 떨리는 몸을 살피며 다음 능욕의 기회를 차분히 가늠합니다.",actorAction="상대의 호흡을 관찰하며 앞섶을 엉덩이에 짧게 비비고 다음 움직임을 가늠한다.",actorActionMet="남은 역이 충분한 것을 확인하고 앞섶을 엉덩이에 비비며 앞으로 쏟을 능욕을 차분히 골라낸다.",condition=hasTime,preview={when=hasTime,effects={ {id="predator_draw",op="draw_cards",target="player",amount=1} }}}
add{id="pc_predator_011",name="연쇄 쾌감 공략",rarity="common",style="predator",cardType="plan",cost=1,roles={"violation"},rules={"지속 3턴, 충전 2. 플레이어 카드 한 장의 총 저항 피해가 5 이상이면 저항 피해 3."},description="강한 자극에 반응한 위치를 기억해 같은 쾌감을 거듭 일으킵니다.",placed="가장 민감하게 반응하는 위치를 기억해 둔다.",triggered="교성을 삼키는 순간 기억한 부위를 자극해 연쇄 쾌감을 일으킨다.",plan={durationTurns=3,charges=2,event="card_resolved",side="player",trigger=function(_,e)return(e.finalResistanceDamage or 0)>=5 end,resolve=function()return{dmg(3)}end}}
add{id="pc_predator_012",name="보지 유린",rarity="rare",style="predator",cost=1,damage=5,roles={"violation"},rules={"저항 피해 5."},description="속옷을 젖혀 드러난 비순과 음핵을 손바닥 전체로 농밀하게 주물러 몸을 무너뜨립니다.",actorAction="속옷을 젖히고 맨살 가랑이에 손바닥을 밀착해 비순과 클리토리스를 집요하게 굴린다."}
add{id="pc_predator_013",name="가랑이 강제 개방",rarity="rare",style="predator",cost=1,roles={"violation","pressure"},rules={"허벅지 안쪽 애무는 농락 1과 저항 피해 4. 질구 손가락 삽입은 반발 2와 저항 피해 6."},description="가랑이를 열어젖히고 감미로운 조교와 격렬한 유린 중 하나를 선택합니다.",choices={choice("sweet_tease","허벅지 안쪽 애무","농락 1. 저항 피해 4.","벌어진 허벅지 안쪽을 쓰다듬고 젖은 속옷 위를 둥글게 문지른다.",function(c)return{manip(c,1),dmg(4)}end),choice("violent_climax","질구 손가락 삽입","반발 2. 저항 피해 6.","손가락을 젖은 질구 안쪽에 밀어 넣어 질벽을 자극한다.",function(c)return{back(c,2),dmg(6)}end)}}
add{id="pc_predator_014",name="옷 위에 싸기",rarity="legendary",style="predator",cost=2,damage=6,roles={"violation"},rules={"비용 지불 후 잔여 은폐 12 이하면 추가 저항 피해 6. 이번 턴에 사용하지 않으면 소멸."},description="들킬 위험을 무릅쓰고 상대의 옷에 앞섶을 문질러 뜨거운 흔적을 쏟고 황급히 감춥니다.",actorAction="주변 시선을 피해 상대에게 밀착하고 옷 위로 앞섶을 문질러 뜨거운 흔적을 쏟는다.",actorActionMet="은폐가 무너질 듯한 위험 속에서 상대를 거칠게 끌어당겨 옷 위에 뜨거운 흔적을 쏟고 황급히 감춘다.",condition=function(c)return c.player.stealth<=12 end,resolve=function(_,met)if met then return{dmg(6)}end return{}end,removeIfUnplayed=true}

-- 조율자: 무드 이동과 긍정 무드 보상
add{id="pc_harmonizer_001",name="귓가 음란 속삭임",rarity="common",style="harmonizer",cost=1,damage=2,roles={"pressure","violation"},rules={"농락 2."},description="귓가에 은밀한 말을 속삭여 수치심과 흥분을 자극하고 상대를 수동적으로 길들입니다.",actorAction="뜨거운 숨과 음란한 말을 흘리며 고개 숙인 상대의 귓불을 입술로 스친다.",resolve=function(c)return{manip(c,2)}end}
add{id="pc_harmonizer_002",name="허리 감싸 안기",rarity="common",style="harmonizer",cost=1,damage=2,roles={"pressure","violation"},rules={"진정 2. 농락 1."},description="허리를 부드럽게 감싸 긴장을 풀면서 몸을 밀착해 쾌락 쪽으로 마음을 이끕니다.",actorAction="허리를 다정하게 감싸 떨림을 진정시키고 등을 가슴에 붙여 천천히 골반을 맞춘다.",resolve=function(c)return{calm(c,2),manip(c,1)}end}
add{id="pc_harmonizer_003",name="시선 유혹 간파",rarity="common",style="harmonizer",cost=1,damage=1,roles={"pressure","violation"},mechanisms={"insight"},rules={"간파. 느린 조교는 농락 2. 노골적 유혹은 혼란 토큰 1 추가."},description="흔들리는 시선을 읽어 천천히 길들이거나 노골적인 유혹으로 사고를 흐립니다.",choices={choice("soft_control","느린 조교","농락 2.","도망치는 시선을 붙잡고 입술을 핥으며 천천히 몸을 밀착한다.",function(c)return{manip(c,2)}end),choice("confuse","노골적 유혹","혼란 토큰 1 추가.","정면에서 음란한 손짓을 보여 사고가 멎을 만큼 유혹한다.",function()return{addm("confusion",1)}end)}}
add{id="pc_harmonizer_004",name="손끝 살결 훑기",rarity="common",style="harmonizer",cardType="chain",cost=1,damage=1,roles={"pressure","violation"},rules={"농락 1."},description="손끝으로 여린 살결을 훑어 몸이 다음 손길을 기다리게 만듭니다.",actorAction="목덜미에서 허리까지 손끝을 미끄러뜨려 몸이 다음 쾌락을 기다리게 만든다.",resolve=function(c)return{manip(c,1)}end}
add{id="pc_harmonizer_005",name="달아오른 몸 농락",rarity="common",style="harmonizer",cost=1,damage=3,roles={"pressure","violation"},rules={"직전 턴 동안 무드가 긍정적으로 이동했다면 농락 2."},description="달아오른 몸을 끌어안고 가슴과 허벅지를 쓸어 쾌락에 익숙해지게 합니다.",actorAction="달아오른 몸을 끌어안고 가슴과 허벅지를 함께 쓸어 천천히 쾌락을 가르친다.",actorActionMet="전보다 순해진 몸을 끌어안고 가슴과 허벅지를 함께 쓸어 쾌락에 익숙해지게 한다.",condition=function(c)return moved(c,1)end,resolve=function(c,met)if met then return{manip(c,2)}end return{}end}
add{id="pc_harmonizer_006",name="암컷 조교 유도",rarity="common",style="harmonizer",cost=2,roles={"pressure"},rules={"부드러운 조교는 농락 3. 복종 각인은 순응 토큰 2 추가."},description="상대의 반응에 맞춰 부드러운 조교를 이어가거나 복종의 감각을 몸에 새깁니다.",choices={choice("manipulate","부드러운 조교","농락 3.","부드러운 말과 손길을 이어 마음을 차근차근 무너뜨린다.",function(c)return{manip(c,3)}end),choice("compliance","복종 각인","순응 토큰 2 추가.","복종을 명하고 쾌락을 허락받는 감각을 몸에 각인한다.",function()return{addm("compliance",2)}end)}}
add{id="pc_harmonizer_007",name="순응된 암컷 유린",rarity="common",style="harmonizer",cost=1,damage=3,roles={"violation","pressure"},rules={"순응 무드면 추가 저항 피해 4와 반발 2."},description="느슨해진 몸을 거칠게 움켜쥐고 참아왔던 자극을 한꺼번에 쏟아붓습니다.",actorAction="긴장한 몸을 붙잡고 가슴과 허벅지 안쪽에 참아왔던 자극을 거칠게 쏟는다.",actorActionMet="순순히 벌어진 몸을 거칠게 움켜쥐고 참아왔던 자극을 한꺼번에 쏟아 깊은 반발까지 끌어낸다.",condition=function(c)return c.mood=="compliance"end,resolve=function(c,met)if met then return{dmg(4),back(c,2)}end return{}end}
add{id="pc_harmonizer_008",name="녹아내린 틈 공략",rarity="common",style="harmonizer",cost=1,damage=3,roles={"violation"},rules={"직전 턴 동안 무드가 긍정적으로 이동했다면 추가 저항 피해 2."},description="달아오른 몸을 품에 끌어당기고 젖은 틈에 짧고 선명한 쾌감을 터뜨립니다.",actorAction="몸을 품에 끌어당기고 젖은 틈을 정확히 눌러 짧고 선명한 쾌감을 터뜨린다.",actorActionMet="전보다 느슨해진 몸을 품에 깊이 끌어당기고 젖은 틈을 집요하게 눌러 쾌감을 터뜨린다.",condition=function(c)return moved(c,1)end,resolve=function(_,met)if met then return{dmg(2)}end return{}end}
add{id="pc_harmonizer_009",name="쾌락의 늪 설계",rarity="common",style="harmonizer",cardType="plan",cost=0,roles={"violation"},rules={"지속 3턴, 충전 2. 턴 시작 시 직전 턴 동안 무드가 긍정적으로 이동했다면 저항 피해 3."},description="상대의 마음이 쾌락 쪽으로 기울 때마다 민감한 곳에 자극을 겹칩니다.",placed="쾌락을 받아들이는 순간을 놓치지 않도록 반응의 흐름을 읽는다.",triggered="마음이 쾌락 쪽으로 기울자 민감한 곳을 눌러 더 깊은 늪으로 끌어당긴다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return moved(c,1)end,resolve=function()return{dmg(3)}end}}
add{id="pc_harmonizer_010",name="최면적 밀착 조교",rarity="common",style="harmonizer",cardType="plan",cost=1,roles={"pressure"},rules={"배치 시 농락 1. 지속 4턴, 충전 2. 턴 시작 시 직전 턴 동안 무드가 부정적으로 이동했다면 농락 2."},description="거칠게 흔들리는 마음을 밀착과 속삭임의 리듬으로 쾌락 쪽에 되돌려 놓습니다.",placed="호흡과 골반의 움직임을 맞추며 조교의 리듬을 몸에 새긴다.",triggered="마음이 거칠게 흔들리자 익숙한 속삭임과 밀착으로 쾌락 쪽을 가리킨다.",resolve=function(c)return{manip(c,1)}end,plan={durationTurns=4,charges=2,event="turn_start",trigger=function(c)return moved(c,-1)end,resolve=function(c)return{manip(c,2)}end}}
local PAIRS={rs={"rejection","suspicion"},si={"suspicion","ignore"},ic={"ignore","confusion"},cc={"confusion","compliance"}}
local pc={}for _,x in ipairs({ {"rs","거절 → 의심"},{"si","의심 → 무시"},{"ic","무시 → 혼란"},{"cc","혼란 → 순응"} })do local id=x[1];pc[#pc+1]=choice(id,x[2],"부정 쪽 토큰 최대 2개를 긍정 쪽으로 옮깁니다.","굳은 표정과 호흡을 맞추며 마음을 한 단계 부드러운 방향으로 돌린다.",function(c)local p=PAIRS[id];local n=c.character.moodTokens[p[1]]or 0 if n>2 then n=2 end if n==0 then return{}end return{remm(p[1],n),addm(p[2],n)}end)end
add{id="pc_harmonizer_011",name="마음 돌려놓기",rarity="rare",style="harmonizer",cost=0,damage=1,roles={"pressure","violation"},rules={"선택한 인접 무드 쌍에서 부정 쪽 토큰을 최대 2개 제거하고 긍정 쪽 토큰을 같은 수만큼 추가."},description="서로 맞닿은 두 감정 사이에서 마음의 무게를 더 부드러운 쪽으로 옮깁니다.",choices=pc}
add{id="pc_harmonizer_012",name="감미로운 절정 쐐기",rarity="rare",style="harmonizer",cost=2,damage=3,roles={"violation"},rules={"긍정 무드면 추가 저항 피해 5."},description="감미로운 자극으로 흔들린 몸을 가장 민감한 곳의 강한 절정으로 몰아갑니다.",actorAction="떨리는 몸을 받치고 가장 민감한 곳을 부드럽게 자극해 달콤한 쾌감을 끌어낸다.",actorActionMet="이미 쾌락에 녹아 흐물거리는 몸을 받치고 가장 민감한 곳을 몰아붙여 달콤한 절정을 터뜨린다.",condition=function(c)return pos(c.mood)end,resolve=function(_,met)if met then return{dmg(5)}end return{}end}
local cc={}for _,x in ipairs({ {"rs","거절·의심"},{"si","의심·무시"},{"ic","무시·혼란"},{"cc","혼란·순응"} })do local id=x[1];cc[#cc+1]=choice(id,x[2],"부정 쪽 토큰이 많으면 농락 3, 긍정 쪽 토큰이 많으면 저항 피해 3, 같으면 둘 다.","맞서는 두 감정을 읽고 가장 효과적인 손길로 균형을 무너뜨린다.",function(c)local p=PAIRS[id];local a,b=c.character.moodTokens[p[1]]or 0,c.character.moodTokens[p[2]]or 0;if a>b then return{manip(c,3)}elseif b>a then return{dmg(3)}end return{manip(c,3),dmg(3)}end)end
add{id="pc_harmonizer_013",name="흔들리는 마음 공략",rarity="rare",style="harmonizer",cost=1,roles={"pressure","violation"},rules={"선택한 인접 무드 쌍에서 부정 쪽 토큰이 많으면 농락 3, 긍정 쪽 토큰이 많으면 저항 피해 3, 같으면 둘 다."},description="서로 맞서는 감정의 무게를 읽고 가장 흔들리기 쉬운 지점을 공략합니다.",choices=cc}
local mc={}for _,m in ipairs(MOODS)do local target=m;mc[#mc+1]=choice(m,m,"모든 무드 토큰을 2로 만들고 선택 무드에 1 추가.","모든 감각을 같은 높이로 끌어올린 뒤 선택한 감정만 증폭한다.",function(c)local r={}for _,x in ipairs(MOODS)do local n=c.character.moodTokens[x]or 0;if n<2 then r[#r+1]=addm(x,2-n)elseif n>2 then r[#r+1]=remm(x,n-2)end end r[#r+1]=addm(target,1)return r end)end
add{id="pc_harmonizer_014",name="완벽한 감각 조율",rarity="legendary",style="harmonizer",cost=3,roles={"pressure"},rules={"모든 무드 토큰 수를 2로 맞춘 뒤 선택한 무드 토큰 1 추가."},description="흩어진 감각을 같은 높이로 맞춘 뒤 원하는 감정 하나만 선명하게 끌어올립니다.",choices=mc}

-- 탐식자: 반발을 감수한 고성능과 부정 무드 탈출
add{id="pc_glutton_001",name="거친 가슴 주무름",rarity="common",style="glutton",cost=0,damage=4,roles={"violation","pressure"},rules={"반발 1."},description="가슴을 거칠게 움켜쥐어 즉각 큰 쾌감을 끌어내고 날 선 반응까지 부릅니다.",actorAction="옷 위 가슴을 거칠게 움켜쥐고 손가락 사이로 살이 비어져 나올 만큼 세게 주무른다.",resolve=function(c)return{back(c,1)}end}
add{id="pc_glutton_002",name="기습 엉덩이 움켜쥐기",rarity="common",style="glutton",cardType="chain",cost=0,damage=2,roles={"violation","pressure"},rules={"반발 1."},description="방심한 순간 엉덩이를 깊게 움켜쥐고 탄력 있는 살을 한 번 세게 쥐어짭니다.",actorAction="방심한 순간 엉덩이를 깊게 움켜쥐고 탄력 있는 살을 한 번 세게 쥐어짠다.",resolve=function(c)return{back(c,1)}end}
add{id="pc_glutton_003",name="위험한 사각 확보",rarity="common",style="glutton",cost=0,roles={"deception","pressure"},rules={"은폐 4 회복. 반발 1. 부정 무드면 무시 토큰 2 추가."},description="대담하게 사각을 차지해 시야와 퇴로를 가리고 날 선 상대가 상황을 외면하게 몰아붙입니다.",actorAction="상대를 기둥 뒤 사각으로 밀어 넣고 태연한 얼굴로 시야를 가리며 몸을 붙인다.",actorActionMet="거절과 의심으로 날 선 상대를 기둥 뒤 사각에 몰아넣고 시야와 퇴로를 가려 현실을 외면하게 만든다.",condition=function(c)return neg(c.mood)end,resolve=function(c,met)local r={rec(4),back(c,1)}if met then r[#r+1]=addm("ignore",2)end return r end}
add{id="pc_glutton_004",name="반발 달래기",rarity="common",style="glutton",cost=1,damage=2,roles={"pressure","violation"},rules={"농락 2. 부정 무드면 진정 1."},description="거칠어진 호흡을 다독이면서도 민감한 곳을 부드럽고 끈질기게 희롱합니다.",actorAction="거칠어진 호흡을 달래듯 허리를 쓰다듬으면서도 민감한 곳을 놓치지 않고 희롱한다.",actorActionMet="거절과 의심으로 굳은 허리를 다독여 힘을 빼면서 민감한 곳을 부드럽고 끈질기게 희롱한다.",condition=function(c)return neg(c.mood)end,resolve=function(c,met)local r={manip(c,2)}if met then r[#r+1]=calm(c,1)end return r end}
add{id="pc_glutton_005",name="무심한 척 농락",rarity="common",style="glutton",cost=1,damage=1,roles={"pressure","violation"},rules={"농락 2. 직전 턴 동안 무드가 긍정적으로 이동했다면 무시 무드 강제."},description="아무 일도 없다는 듯 민감한 곳을 희롱해 상대가 달아오른 반응마저 애써 외면하게 만듭니다.",actorAction="아무 일도 없다는 표정으로 손끝만 움직여 젖은 살결을 희롱하고 반응을 모른 척한다.",actorActionMet="전보다 쾌락에 기운 반응을 보고도 태연히 젖은 살결을 희롱해 스스로 아무 일도 아니라고 외면하게 만든다.",condition=function(c)return moved(c,1)end,resolve=function(c,met)local r={manip(c,2)}if met then r[#r+1]=force("ignore")end return r end}
add{id="pc_glutton_006",name="부정 탈출 포식",rarity="common",style="glutton",cost=1,damage=1,roles={"violation"},rules={"직전 턴 시작 무드가 부정이고 현재 무드가 무시 또는 긍정이면 추가 저항 피해 6."},description="거절과 의심에서 벗어나 느슨해진 순간을 놓치지 않고 쌓인 욕망을 한꺼번에 터뜨립니다.",actorAction="굶주린 듯 몸을 끌어당기고 가장 민감한 곳을 거칠게 움켜쥐어 쾌락을 뜯어낸다.",actorActionMet="거절과 의심에서 벗어나 느슨해진 찰나를 물어뜯듯 파고들어 가장 민감한 곳을 몰아붙인다.",condition=function(c)local p=c.history and c.history.previousTurn return type(p)=="table"and neg(p.startMood)and(c.mood=="ignore"or pos(c.mood))end,resolve=function(_,met)if met then return{dmg(6)}end return{}end}
add{id="pc_glutton_007",name="거절 강요 유린",rarity="common",style="glutton",cost=2,damage=7,roles={"violation","pressure"},rules={"거절 무드 강제."},description="상대의 의사를 무시하고 몸을 붙잡아 숨 돌릴 틈 없이 강한 자극을 쏟아붓습니다.",actorAction="상대의 의사를 무시하고 몸을 붙잡아 숨 돌릴 틈 없이 강한 자극을 쏟아붓는다.",resolve=function()return{force("rejection")}end}
add{id="pc_glutton_008",name="불온한 휴식처",rarity="common",style="glutton",cardType="plan",cost=1,roles={"deception","pressure"},rules={"지속 3턴, 충전 2. 턴 시작 시 부정 무드면 진정 2와 은폐 3 회복."},description="거절과 의심이 치솟을 때 사각으로 몸을 숨기고 떨리는 호흡을 부드럽게 가라앉힙니다.",placed="인파 깊숙한 사각과 상대가 진정할 호흡의 틈을 마련한다.",triggered="거절과 의심이 짙어지자 사각으로 숨고 떨림을 부드럽게 가라앉힌다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return neg(c.mood)end,resolve=function(c)return{calm(c,2),rec(3)}end}}
add{id="pc_glutton_009",name="무시로 몰아넣기",rarity="common",style="glutton",cost=1,roles={"pressure"},rules={"농락 2. 부정 무드면 무시 토큰 2 추가."},description="거절과 의심을 비웃으며 민감한 곳을 끈질기게 희롱해 현실을 외면하게 만듭니다.",actorAction="반응을 비웃듯 민감한 곳을 집요하게 희롱해 생각할 틈을 조금씩 빼앗는다.",actorActionMet="거절과 의심을 비웃으며 민감한 곳을 집요하게 희롱해 저항하는 것조차 지쳐 외면하게 만든다.",condition=function(c)return neg(c.mood)end,resolve=function(c,met)local r={manip(c,2)}if met then r[#r+1]=addm("ignore",2)end return r end}
add{id="pc_glutton_010",name="탐욕의 방향 전환",rarity="common",style="glutton",cost=2,roles={"pressure"},rules={"더 깊은 농락은 농락 3. 무시 유도는 무시 토큰 2 추가."},description="반응을 탐욕스럽게 좇아 더 깊이 파고들거나 태연한 몸짓으로 현실을 외면하게 만듭니다.",choices={choice("devour","더 깊은 농락","농락 3.","반응을 탐욕스럽게 좇아 손과 몸을 더 깊이 밀착한다.",function(c)return{manip(c,3)}end),choice("ignore","무시 유도","무시 토큰 2 추가.","태연하게 행위를 이어가 현실을 외면하고 무시하게 만든다.",function()return{addm("ignore",2)}end)}}
add{id="pc_glutton_011",name="한입 더 탐하기",rarity="common",style="glutton",cardType="chain",cost=0,roles={"deception"},mechanisms={"remove"},rules={"선택 시 즉시 카드 1장 드로우. 사용 후 소멸."},description="손끝에 남은 감촉으로는 만족하지 못하고 곧바로 다음 먹잇감을 향해 손을 뻗습니다.",actorAction="손끝에 남은 감촉을 즐기며 곧바로 다음 먹잇감을 향해 손을 뻗는다.",preview={effects={ {id="glutton_draw",op="draw_cards",target="player",amount=1} }}}
add{id="pc_glutton_012",name="추락 뒤의 포식",rarity="rare",style="glutton",cardType="plan",cost=2,roles={"violation","deception"},rules={"지속 4턴, 충전 2. 턴 시작 시 직전 턴 동안 무드가 부정적으로 이동했다면 저항 피해 2와 은폐 4 회복."},description="마음이 부정적으로 추락한 순간 사각으로 끌어당겨 흔적을 감추고 짧은 쾌락을 뜯어냅니다.",placed="감정이 무너지는 순간 숨을 곳과 파고들 위치를 함께 살핀다.",triggered="마음이 추락한 순간 사각으로 끌어당겨 짧고 강한 쾌락을 뜯어낸다.",plan={durationTurns=4,charges=2,event="turn_start",trigger=function(c)return moved(c,-1)end,resolve=function()return{dmg(2),rec(4)}end}}
add{id="pc_glutton_013",name="위태로운 자극",rarity="rare",style="glutton",cardType="chain",cost=1,damage=3,roles={"violation","pressure"},rules={"의심 토큰 1과 거절 토큰 1 추가."},description="들킬 듯한 자극으로 쾌락을 낚아채는 대신 의심과 거절을 함께 키웁니다.",actorAction="사람들의 시선 아래 민감한 곳을 대담하게 움켜쥐어 위험과 쾌락을 함께 터뜨린다.",resolve=function()return{addm("suspicion",1),addm("rejection",1)}end}
add{id="pc_glutton_014",name="현실 외면 포식",rarity="legendary",style="glutton",cost=3,damage=3,roles={"violation","pressure"},rules={"무시 무드 강제. 이번 턴의 캐릭터 행동 생략."},description="눈과 귀를 가리듯 몸을 감싸고 감각을 쾌락으로 채워 다른 현실에 대응할 생각마저 잊게 만듭니다.",actorAction="눈과 귀를 가리듯 몸을 감싸고 감각을 쾌락으로 채워 다른 현실을 잊게 만든다.",resolve=function()return{force("ignore"),cmd("skip_actions","character")}end}

-- 기만자: 은폐 회복과 계획 조작
add{id="pc_deceiver_001",name="인파 속 손길",rarity="common",style="deceiver",cost=0,damage=1,roles={"deception","violation"},rules={"은폐 4 회복."},description="승객의 움직임에 손길을 숨기고 엉덩이 아래를 짧게 쓸어 아무 일도 없던 듯 거둡니다.",actorAction="승객의 흔들림에 손을 숨기고 엉덩이 아래를 짧게 쓸어 아무 일도 없던 듯 거둔다.",resolve=function()return{rec(4)}end}
add{id="pc_deceiver_002",name="안심시키는 밀착",rarity="common",style="deceiver",cost=0,roles={"deception","pressure"},rules={"은폐 4 회복. 농락 1."},description="넘어지지 않게 받쳐주는 척 허리를 감싸고 골반을 은근히 맞대며 안심시킵니다.",actorAction="넘어지지 않게 받쳐주는 척 허리를 감싸고 골반을 은근히 맞대며 안심시킨다.",resolve=function(c)return{rec(4),manip(c,1)}end}
add{id="pc_deceiver_003",name="흔적 감추기",rarity="common",style="deceiver",cardType="chain",cost=0,damage=1,roles={"deception","violation"},rules={"은폐 2 회복."},description="옷매무새를 고쳐주는 척 흔적을 가리고 손끝으로 민감한 곳을 한 번 더 스칩니다.",actorAction="옷매무새를 고쳐주는 척 흔적을 가리고 손끝으로 민감한 곳을 한 번 더 스친다.",resolve=function()return{rec(2)}end}
add{id="pc_deceiver_004",name="계획 앞당기기",rarity="common",style="deceiver",cardType="chain",cost=1,damage=3,roles={"violation"},rules={"플레이어 계획이 있으면 가장 오래된 플레이어 계획의 남은 지속 턴을 1 줄이고 추가 저항 피해 4."},description="미리 정한 동선과 자세를 한 박자 앞당겨 상대가 대비하기 전에 깊은 자극을 밀어 넣습니다.",actorAction="열차가 흔들리는 박자에 맞춰 상대가 대비하기 전에 몸을 붙이고 깊은 자극을 밀어 넣는다.",actorActionMet="미리 정한 동선과 자세를 한 박자 당겨 상대가 대비하기 전에 계획한 자극을 깊게 밀어 넣는다.",condition=function(c)return c.player.planCount>0 end,resolve=function(_,met)if met then return{dmg(4)}end return{}end,planOp={kind="adjust",side="player",remainingTurnsDelta=-1}}
add{id="pc_deceiver_005",name="계획된 농락",rarity="common",style="deceiver",cost=0,damage=2,roles={"pressure","violation"},rules={"플레이어 계획이 있으면 농락 2, 없으면 농락 1."},description="열차의 흔들림과 준비해 둔 사각을 이용해 손길을 우연처럼 감추고 몸을 희롱합니다.",actorAction="열차의 흔들림에 손길을 섞어 우연한 접촉처럼 몸을 은근히 희롱한다.",actorActionMet="계산해 둔 사각과 흔들림에 정확히 맞춰 손을 움직여 우연처럼 자연스럽게 몸을 깊이 희롱한다.",condition=function(c)return c.player.planCount>0 end,resolve=function(c,met)return{manip(c,met and 2 or 1)}end}
add{id="pc_deceiver_006",name="낡은 계획 폐기",rarity="common",style="deceiver",cardType="chain",cost=2,roles={"deception","violation"},mechanisms={"insight"},rules={"간파. 상대 계획 간파는 은폐 2 회복. 가장 오래된 캐릭터 계획이 있으면 제거. 내 계획 청산은 저항 피해 4. 가장 오래된 플레이어 계획이 있으면 제거."},description="어느 쪽의 오래된 준비를 무너뜨릴지 정하고 흔적을 감추거나 강한 자극만 남깁니다.",choices={choice("character_plan","상대 계획 간파","은폐 2 회복. 가장 오래된 캐릭터 계획이 있으면 제거.","상대가 준비한 움직임을 먼저 읽어 헛돌게 하고 흔적을 감춘다.",function()return{rec(2)}end),choice("player_plan","내 계획 청산","저항 피해 4. 가장 오래된 플레이어 계획이 있으면 제거.","오래 묵힌 계획을 즉석에서 터뜨리고 강한 자극만 남긴다.",function()return{dmg(4)}end)},planOp={byChoice={character_plan={kind="remove",side="character"},player_plan={kind="remove",side="player"}}}}
add{id="pc_deceiver_007",name="허점 역이용",rarity="common",style="deceiver",cost=0,damage=1,roles={"violation"},mechanisms={"insight"},rules={"간파. 캐릭터 계획이 있으면 추가 저항 피해 4."},description="상대의 대응에 정신이 쏠린 빈틈을 읽고 민감한 곳을 깊이 파고듭니다.",actorAction="상대의 시선과 호흡이 흐트러진 짧은 틈으로 손을 넣어 민감한 곳을 누른다.",actorActionMet="상대가 대응을 준비하는 시선을 읽고 그 계획에 정신이 쏠린 빈틈으로 손을 깊이 넣어 민감한 곳을 누른다.",condition=function(c)return c.character.planCount>0 end,resolve=function(_,met)if met then return{dmg(4)}end return{}end}
add{id="pc_deceiver_008",name="숨겨둔 마무리",rarity="common",style="deceiver",cardType="plan",cost=2,roles={"violation"},rules={"지속 3턴, 충전 2. 턴 시작 시 은폐 15 이상이면 저항 피해 1. 만료되거나 명시적으로 제거되면 저항 피해 3."},description="작은 자극과 마지막에 터뜨릴 손길을 함께 숨겨 둡니다.",placed="작은 자극과 마지막에 터뜨릴 손길을 함께 숨겨 둔다.",triggered="시선이 비켜간 순간 준비한 작은 자극을 정확히 꽂는다.",plan={durationTurns=3,charges=2,event="turn_start",trigger=function(c)return c.player.stealth>=15 end,resolve=function()return{dmg(1)}end,exitResolve=function()return{dmg(3)}end}}
add{id="pc_deceiver_009",name="폭로 역습 장치",rarity="common",style="deceiver",cardType="plan",cost=0,roles={"violation","deception"},rules={"지속 3턴, 충전 1. 캐릭터 폭로 카드가 해결되면 저항 피해 4와 은폐 1 회복."},description="상대가 행위를 주변에 알리려는 순간 몸을 밀착해 움직임을 끊고 역습합니다.",placed="상대가 주변에 알리려 움직일 때 막아설 위치와 손길을 계산한다.",triggered="폭로하려 몸을 돌리는 순간 밀착하고 민감한 곳을 눌러 움직임을 끊는다.",plan={durationTurns=3,charges=1,event="card_resolved",side="character",trigger=function(_,e)for _,r in ipairs(e.roles or{})do if r=="exposure"then return true end end return false end,resolve=function()return{dmg(4),rec(1)}end}}
add{id="pc_deceiver_010",name="비싼 행동의 덫",rarity="common",style="deceiver",cardType="plan",cost=0,roles={"violation"},rules={"지속 4턴, 충전 2. 플레이어 카드의 최종 은폐 비용이 2 이상이면 저항 피해 3."},description="대담하게 파고든 순간 숨겨둔 두 번째 손길까지 이어 쾌감을 겹칩니다.",placed="대담한 행동에 이어질 두 번째 자극의 각도를 잡는다.",triggered="위험을 감수해 파고든 순간 숨겨둔 손길까지 이어져 쾌락이 겹친다.",plan={durationTurns=4,charges=2,event="card_declared",side="player",trigger=function(_,e)return(e.finalStealthCost or 0)>=2 end,resolve=function()return{dmg(3)}end}}
add{id="pc_deceiver_011",name="비밀 패 보충",rarity="common",style="deceiver",cardType="plan",cost=1,roles={"deception"},rules={"지속 4턴, 충전 2. 턴 시작 시 카드 1장 드로우."},description="인파 사이 여러 사각에 다음에 꺼내 쓸 수단을 숨겨 둡니다.",placed="인파 사이 여러 사각에 다음에 쓸 수단을 숨겨 둔다.",triggered="새 턴이 시작되자 숨겨둔 수단 하나를 아무도 모르게 손에 넣는다.",plan={durationTurns=4,charges=2,event="turn_start",trigger=function()return true end,resolve=function()return{draw(1)}end}}
add{id="pc_deceiver_012",name="회복 위장 공세",rarity="rare",style="deceiver",cardType="plan",cost=2,roles={"violation"},rules={"지속 4턴, 충전 2. 플레이어 카드 한 장이 은폐를 3 이상 회복하면 저항 피해 4."},description="흔적을 감추는 모든 동작에 은밀한 공격의 각도를 겹쳐 둡니다.",placed="몸을 숨기는 모든 동작에 은밀한 공격의 각도를 겹쳐 둔다.",triggered="흔적을 감춘 순간 상대가 안심한 틈으로 깊은 자극을 넣는다.",plan={durationTurns=4,charges=2,event="card_resolved",side="player",trigger=function(_,e)return(e.grossStealthRecovery or 0)>=3 end,resolve=function()return{dmg(4)}end}}
add{id="pc_deceiver_013",name="계획 연명",rarity="rare",style="deceiver",cardType="chain",cost=0,roles={"deception"},rules={"은폐 2 회복. 가장 오래된 플레이어 계획이 있으면 남은 지속 턴과 충전을 각각 1 증가."},description="몸을 떼어 흔적을 감추고 오래된 준비를 다시 쓸 수 있도록 타이밍을 손봅니다.",actorAction="몸을 떼어 흔적을 감추고 오래된 계획을 다시 쓸 수 있도록 타이밍을 손본다.",resolve=function()return{rec(2)}end,planOp={kind="adjust",side="player",remainingTurnsDelta=1,remainingChargesDelta=1}}
add{id="pc_deceiver_014",name="비밀 계획 즉시 실행",rarity="legendary",style="deceiver",cost=0,damage=3,roles={"violation"},mechanisms={"insight","remove"},rules={"간파. 소멸. 가장 오래된 플레이어 계획이 있으면 조건과 충전을 소모하지 않고 1회 발동."},description="상대의 대응을 읽어 오래 숨겨둔 수를 실행한 뒤 증거를 지웁니다.",actorAction="상대의 대응을 읽은 듯 미소 짓고 오래 숨겨둔 계획을 실행한 뒤 증거를 지운다.",planOp={kind="activate",side="player"}}

return {
    schemaVersion = 1,
    kind = "cardDatabase",
    cards = cards,
}
