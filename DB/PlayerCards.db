                    },
                    {
                        id = "calm_one", label = "부드럽게 쓰다듬기", description = "진정 1.",
                        actorAction = "다리 사이를 만지작거리던 손을 엉덩이 바깥쪽 살로 부드럽게 옮겨 원을 그리며 쓸어내린다. 팽팽하게 굳어 있던 허벅지의 긴장이 풀리고 방심할 때까지 느긋하게 애무를 이어간다.",
