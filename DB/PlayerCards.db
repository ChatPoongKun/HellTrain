local MOOD_ORDER = { "rejection", "suspicion", "ignore", "confusion", "compliance" }
local MOOD_INDEX = {}
for index, moodId in ipairs(MOOD_ORDER) do MOOD_INDEX[moodId] = index end

local function command(op, target, amount, mood, cause)
    local value = { op = op, target = target, cause = cause or "cardEffect" }
    if amount ~= nil then value.amount = amount end
    if mood ~= nil then value.mood = mood end
    return value
end

local function damage(amount, cause)
    return command("damage_resistance", "character", amount, nil, cause)
end

local function recoverStealth(amount, cause)
    return command("recover_stealth", "player", amount, nil, cause)
end

local function addMood(mood, amount, cause)
    return command("add_mood_token", "character", amount, mood, cause)
end

local function removeMood(mood, amount, cause)
    return command("remove_mood_token", "character", amount, mood, cause)
end

local function forceMood(mood, cause)
    return command("force_mood", "character", nil, mood, cause)
end

local function negative(mood)
    return mood == "suspicion" or mood == "rejection"
end

local function positive(mood)
    return mood == "confusion" or mood == "compliance"
end

local function adjacentMood(currentMood, delta)
    local index = MOOD_INDEX[currentMood]
    if index == nil then return currentMood end
    local target = index + delta
    if target < 1 then
        target = 1
    elseif target > 5 then
        target = 5
    end
    return MOOD_ORDER[target]
end

local function manipulate(context, amount, cause) -- 농락
    return addMood(adjacentMood(context.mood, 1), amount, cause)
end

local function backlash(context, amount, cause) -- 반발
    return addMood(adjacentMood(context.mood, -1), amount, cause)
end

local function calm(context, amount, cause) -- 진정
    return removeMood(adjacentMood(context.mood, -1), amount, cause)
end

local function cool(context, amount, cause) -- 냉각
    return removeMood(adjacentMood(context.mood, 1), amount, cause)
end

local function movedPositive(previousMood, currentMood)
    local previous = MOOD_INDEX[previousMood]
    local current = MOOD_INDEX[currentMood]
    return previous ~= nil and current ~= nil and current > previous
end

local function hasRole(roles, roleId)
    for _, id in ipairs(roles or {}) do
        if id == roleId then return true end
    end
    return false
end

local function splitCardType(mechanisms)
    local cardType = "action"
    local specials = {}
    for _, id in ipairs(mechanisms or {}) do
        if id == "chain" or id == "plan" then
            cardType = id
        else
            specials[#specials + 1] = id
        end
    end
    return cardType, specials
end

local function card(id, name, roles, cost, resistanceDamage, mechanisms, description, rules, actorAction, extra)
    if type(roles) == "string" then roles = { roles } end
    local cardType, specials = splitCardType(mechanisms)
    local value = {
        id = id,
        owner = "player",
        name = name,
        description = description,
        cardType = cardType,
        roles = roles,
        mechanisms = specials,
        base = { stealthCost = cost, resistanceDamage = resistanceDamage },
        rules = rules,
        narration = { play = { actorAction = actorAction } },
    }
    for key, item in pairs(extra or {}) do value[key] = item end
    return value
end

local function planCard(id, name, tag, cost, description, rules, placedAction, triggeredAction, plan, extra)
    local value = card(id, name, tag, cost, 0, { "plan" }, description, rules, placedAction, extra)
    value.narration = {
        planPlaced = { actorAction = placedAction },
        planTriggered = { actorAction = triggeredAction },
    }
    value.mechanismData = { plan = plan }
    return value
end

