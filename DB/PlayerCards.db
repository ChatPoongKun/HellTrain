            "::tag[violation]:: 거부하는 말과 달리 보짓물로 흥건하게 젖어버린 속옷과 뜨겁게 팽창한 비순을 손가락으로 짚어내며 배덕적인 절정을 강요합니다.",
            { "현재 무드가 직전 턴 최종 무드보다 긍정적이면 추가 저항 피해 4." },
            "허벅지 안쪽에 흠뻑 젖어 투명하게 비치는 속옷 자국을 손가락 끝으로 훑으며 \"싫다고 고개를 저으면서... 아래는 이렇게 애액을 뚝뚝 흘리고 있네요. 말보다 이 음란하게 젖은 구멍이 훨씬 솔직한 거 아닌가요?♥\"라고 귓가에 낮게 조롱한다.",
            {
                resolve = function(context)
                    local previous = context.history.previousTurn
                    if previous ~= nil and movedPositive(previous.endMood, context.mood) then return { damage(4) } end
                    return {}
                end,
            }
        ),

        p041_reach_under_skirt = card(
            "p041_reach_under_skirt", "하의 속으로 손 집어넣고 클리 비비기", "violation", 5, 7, {},
            "::tag[violation]:: 이성이 마비된 틈을 놓치지 않고 하의 속으로 손을 깊숙이 찔러 넣어, 축축하게 젖은 속옷 안쪽의 맨살과 비순을 노골적으로 유린합니다.",
            { "혼란 또는 순응이면 은폐 비용 2, 그 외에는 은폐 비용 5.", "혼란이면 추가 저항 피해 2.", "순응이면 추가 저항 피해 4." },
            "하의 속으로 거침없이 손을 밀어 넣어, 한 손으로는 탄력 있는 맨살 엉덩이를 꽉 움켜쥐고 다른 손으로는 젖어 축축한 속옷 안으로 손가락을 파고든다. 흠뻑 젖은 비순과 딱딱하게 발기한 음핵을 손가락 마디로 부드럽고 끈적하게 비벼 문지른다.",
            {
                stealthCostByMood = { confusion = 2, compliance = 2 },
                resolve = function(context)
                    if context.mood == "compliance" then return { damage(4) } end
                    if context.mood == "confusion" then return { damage(2) } end
                    return {}
                end,
            }
        ),

        p043_finger_penetration = card(
            "p043_finger_penetration", "젖은 속옷 제치고 손가락 밀어넣기", { "pressure", "violation" }, 6, 9, { "remove" },
            "::tag[violation]:: 애액으로 흠뻑 젖은 속옷을 옆으로 제쳐 젖은 비순을 노출시키고, 손가락을 질 내 깊숙이 밀어 넣어 절정을 이끌어내는 ::tag[remove]:: 필살기입니다.",
            { "순응이면 추가 저항 피해 6.", "반발 2." },
            "흠뻑 젖어 투명해진 속옷을 손가락으로 살짝 젖혀 보짓물이 흘러내리는 젖은 음부를 드러낸다. 뜨겁게 달아오른 질구에 손가락 두 개를 마디까지 부드럽게 밀어 넣고, 손바닥으로 발기한 음핵을 문지르며 질 안쪽의 민감한 천장을 간질이듯 긁어 올려 전신을 녹아내리게 만든다.",
            {
                resolve = function(context)
                    local commands = {}
                    if context.mood == "compliance" then commands[#commands + 1] = damage(6) end
                    commands[#commands + 1] = backlash(context, 2)
                    return commands
                end,
            }
        ),

        p044_overwhelm_both_halves = card(
            "p044_overwhelm_both_halves", "젖통 주무르며 가랑이 밀착하기", { "pressure", "violation" }, 2, 4, {},
            "::tag[pressure]:: 한 손으로는 젖가슴을 주무르고 앞섶으로는 엉덩이를 비벼대며 상하체를 동시에 농락해 이성을 완전히 무너뜨립니다.",
            { "농락 2." },
            "한 손으로 옷 위를 파고들어 풍만한 가슴을 감싸 쥐듯 애무하며 빳빳하게 선 유두를 굴리고, 동시에 팽창한 앞섶을 엉덩이골 중심에 꽉 밀착해 허리를 돌린다. 상하체에서 쏟아지는 동시 애무에 숨을 쉴 틈조차 주지 않고 녹아내리게 만든다.",
            { resolve = function(context) return { manipulate(context, 2) } end }
        ),

        p045_press_between_thighs = card(
            "p045_press_between_thighs", "풀려버린 가랑이 틈새로 다리 밀착하기", { "pressure", "violation" }, 3, 5, {},
            "::tag[violation]:: 쾌락에 취해 힘없이 벌어진 허벅지 틈새로 다리와 손을 밀어 넣어, 축축하게 젖은 속옷 위로 부푼 음핵을 끈적하게 자극합니다.",
            { "혼란이면 추가 저항 피해 2.", "순응이면 추가 저항 피해 5 후 냉각 1." },
            "쾌감에 녹아내려 벌어진 허벅지 사이로 다리를 깊숙이 밀착해 속옷이 비순 틈새에 바싹 닿게 만든다. 손바닥으로 젖어든 천을 뜨겁게 감싸 쥔 채 손가락 끝으로 발기한 음핵과 젖은 입구를 둥글게 굴리며 자극한다.",
            {
                resolve = function(context)
                    if context.mood == "compliance" then return { damage(5), cool(context, 1) } end
                    if context.mood == "confusion" then return { damage(2) } end
                    return {}
                end,
            }
        ),

        p047_unhesitating_touch = card(
            "p047_unhesitating_touch", "옷 위로 젖통 덥석 주무르기", "violation", 5, 7, { "insight" },
            "::tag[violation]:: 방어하려는 팔을 능숙하게 흘려내고, 옷 위로 솟아오른 양쪽 가슴을 탐욕스럽게 움켜쥐어 유두를 굴려대는 ::tag[insight]:: 행동입니다.",
            { "혼란이면 추가 저항 피해 2.", "순응이면 추가 저항 피해 5." },
            "가슴을 가리려 올라오는 가녀린 팔을 가볍게 쳐낸 뒤, 양손으로 풍만하게 부풀어 오른 가슴을 덥석 움켜쥔다. 손바닥 가득 말랑한 살결을 쫀득하게 주무르며, 옷 위로 빳빳하게 솟아오른 유두를 엄지와 검지 사이에 끼워 야릇하게 굴리고 비튼다.",
            {
                resolve = function(context)
                    if context.mood == "compliance" then return { damage(5) } end
                    if context.mood == "confusion" then return { damage(2) } end
                    return {}
                end,
            }
        ),
    },
}
