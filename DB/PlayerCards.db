    actorAction = "주변 사람들에게 들킬 듯한 아슬아슬한 긴장감 속에서, 오히려 더 거칠게 엉덩이의 풍만한 곡선을 양손으로 감싸 쥐고 발기한 자지를 엉덩이골 사이에 사정없이 짓누르며 뜨거운 쾌락을 깊숙이 끌어올린다.",
    resolve = function(context) if context.player.stealth <= 5 then return { damage(2) } end return {} end,
})

add({
    id = "pc_c18_conditional_role",
    name = "방어 무력화",
    rarity = "common",
    roles = { "pressure", "violation" },
    cost = 1,
    damage = 2,
    rules = { "농락 1.", "공개 역할이 대응 또는 회복이면 추가 저항 피해 2." },
    description = "::tag[pressure]:: ::tag[violation]:: 방어하고 물러서려는 움직임의 반동을 이용해 골반을 단숨에 낚아채고 자지를 더 깊숙이 박아넣는 카운터 유린 행동입니다.",
    actorAction = "몸을 빼내려는 찰나의 빈틈을 파고들어 허리를 낚아채 제 가랑이 쪽으로 강하게 끌어당긴다. 도망치지 못하도록 골반을 밀착한 채 사타구니 안쪽의 말랑한 살결을 억세게 주무른다.",
    resolve = function(context) local result = { manipulate(context, 1) }; if context.character.publicRole == "response" or context.character.publicRole == "recovery" then result[#result + 1] = damage(2) end return result end,
})

