                    },
                },
                moodEffects = {
                    suspicion = function(context) return { addMood("ignore", 1) } end,
                    rejection = function(context) return { addMood("confusion", 1) } end,
                },
            }
        ),

        p036_question_for_reaction = card(
            "p036_question_for_reaction", "반응 유도 질문", "deception", 1, 2, {},
            "::tag[deception]:: 행동으로 공개된 방어 태세를 흔듭니다.",
            { "혼란 토큰 1개 추가.", "공개 태그가 vigilance 또는 block이면 추가 피해 2." },
            "방어에 집중한 틈을 노려 대답하기 곤란한 질문을 던진다.",
            {
                resolve = function(context)
                    local commands = { addMood("confusion", 1) }
                    local tag = context.character.publicActionTag
                    if tag == "vigilance" or tag == "block" then commands[#commands + 1] = damage(2) end
                    return commands
                end,
            }
        ),

        p038_silent_understanding = card(
            "p038_silent_understanding", "침묵의 합의", "approach", 1, 3, {},
            "::tag[approach]:: 행동으로 말없이 호흡을 맞춥니다.",
            { "무시 무드이면 순응 토큰 2개, 그 외에는 무시 토큰 1개 추가." },
            "짧은 침묵 속에서 서로의 호흡을 맞춘다.",
            {
                resolve = function(context)
                    if context.mood == "ignore" then return { addMood("compliance", 2) } end
                    return { addMood("ignore", 1) }
                end,
            }
        ),

        p039_catch_contradiction = card(
            "p039_catch_contradiction", "모순 포착", "observation", 2, 4, {},
            "::tag[observation]:: 행동으로 감정 변화의 모순을 짚습니다.",
            { "현재 무드가 직전 턴 최종 무드와 다르면 추가 피해 2." },
            "방금 전과 달라진 태도의 모순을 정확히 짚는다.",
            {
                resolve = function(context)
                    local previous = context.history.previousTurn
                    if previous ~= nil and previous.endMood ~= context.mood then return { damage(2) } end
                    return {}
                end,
            }
        ),

        p041_break_balance = card(
            "p041_break_balance", "균형 붕괴", "threat", 2, 5, {},
            "::tag[threat]:: 행동으로 감정의 균형을 무너뜨립니다.",
            { "혼란 또는 순응이면 추가 피해 2." },
            "감정이 흔들린 순간을 놓치지 않고 강하게 밀어붙인다.",
            {
                resolve = function(context)
                    if positive(context.mood) then return { damage(2) } end
                    return {}
                end,
            }
        ),

        p043_push_past_limit = card(
            "p043_push_past_limit", "한계 넘기", "violation", 5, 9, { "remove" },
            "::tag[violation]:: 행동으로 한계를 넘어 압박하고, 사용 후 ::tag[remove]::됩니다.",
            { "별도의 추가 효과 없음." },
            "돌이킬 수 없는 선까지 밀어붙여 저항을 크게 무너뜨린다."
        ),

        p044_no_time_to_breathe = card(
            "p044_no_time_to_breathe", "숨 돌릴 틈 없이", "threat", 2, 3, {},
            "::tag[threat]:: 행동으로 쉬지 않고 압박합니다.",
            { "부정 무드이면 혼란 토큰 2개 추가.", "그 외에는 추가 피해 2." },
            "상대가 숨을 고를 틈을 주지 않고 압박의 방향을 바꾼다.",
            {
                resolve = function(context)
                    if negative(context.mood) then return { addMood("confusion", 2) } end
                    return { damage(2) }
                end,
            }
        ),

        p045_lowered_guard = card(
            "p045_lowered_guard", "낮아진 경계", "contact", 1, 4, {},
            "::tag[contact]:: 행동으로 낮아진 경계를 파고듭니다.",
            { "무시·혼란·순응이면 추가 피해 1." },
            "경계가 낮아진 순간에 거리를 좁혀 압박한다.",
            {
                resolve = function(context)
                    if nonNegative(context.mood) then return { damage(1) } end
                    return {}
                end,
            }
        ),

        p047_unhesitating_touch = card(
            "p047_unhesitating_touch", "망설임 없는 손길", "contact", 3, 7, { "insight" },
            "::tag[contact]:: 행동으로 주저 없이 압박하며 ::tag[insight]::를 가집니다.",
            { "별도의 추가 효과 없음." },
            "망설임 없이 움직이면서도 상대가 준비한 반격을 읽는다."
        ),
