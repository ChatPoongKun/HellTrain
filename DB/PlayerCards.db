    rules = { "배치 시 농락 1.", "지속 3턴, 충전 2.", "순응에서 플레이어의 유린 카드 해결 뒤 저항 피해 3." },
    description = "::tag[plan]:: ::tag[pressure]:: ::tag[violation]:: 완전히 굴복한 몸에 손길을 더할 때마다 쾌락이 연쇄적으로 터져 나오도록 각인시키는 ::tag[plan]:: 카드입니다.",
    placedAction = '"이제 거부하지 말고 손길을 온전히 느껴봐요... 몸이 원하는 대로 해줄 테니까♥" 엉덩이의 풍만한 곡선을 부드럽게 쓰다듬는다.',
    triggeredAction = "유린의 손길이 닿자마자 손끝으로 쾌락의 급소를 연쇄적으로 짓눌러, 전신에 오싹한 쾌락의 전류를 내달리게 만든다.",
    resolve = function(context) return { manipulate(context, 1) } end,
    plan = { event = "card_resolved", side = "player", durationTurns = 3, charges = 2, trigger = function(context, event) return event.type == "card_resolved" and event.side == "player" and hasRole(event.roles, "violation") and context.mood == "compliance" end, resolve = function() return { damage(3, "plan") } end },
})

