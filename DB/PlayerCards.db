local MOOD_ORDER = { "rejection", "suspicion", "ignore", "confusion", "compliance" }
local MOOD_INDEX = {}
for index, moodId in ipairs(MOOD_ORDER) do MOOD_INDEX[moodId] = index end

local function command(op, target, amount, mood, cause)
    local value = { op = op, target = target, cause = cause or "cardEffect" }
    if amount ~= nil then value.amount = amount end
    if mood ~= nil then value.mood = mood end
    return value
end

local function damage(amount, cause)
    return command("damage_resistance", "character", amount, nil, cause)
end

local function recoverStealth(amount, cause)
    return command("recover_stealth", "player", amount, nil, cause)
end

local function addMood(mood, amount, cause)
    return command("add_mood_token", "character", amount, mood, cause)
end

local function removeMood(mood, amount, cause)
    return command("remove_mood_token", "character", amount, mood, cause)
end

local function forceMood(mood, cause)
    return command("force_mood", "character", nil, mood, cause)
end

local function adjacentMood(currentMood, delta)
    local index = MOOD_INDEX[currentMood]
    if index == nil then return currentMood end
    local target = index + delta
    if target < 1 then target = 1 end
    if target > #MOOD_ORDER then target = #MOOD_ORDER end
    return MOOD_ORDER[target]
end

local function manipulate(context, amount, cause)
    return addMood(adjacentMood(context.mood, 1), amount, cause)
end

local function backlash(context, amount, cause)
    return addMood(adjacentMood(context.mood, -1), amount, cause)
end

local function calm(context, amount, cause)
    return removeMood(adjacentMood(context.mood, -1), amount, cause)
end

local function cool(context, amount, cause)
    return removeMood(adjacentMood(context.mood, 1), amount, cause)
end

local function negative(mood)
    return mood == "rejection" or mood == "suspicion"
end

local function positive(mood)
    return mood == "confusion" or mood == "compliance"
end

local function hasRole(roles, roleId)
    for _, id in ipairs(roles or {}) do
        if id == roleId then return true end
    end
    return false
end

local cards = {}

local function add(spec)
    local cardType = spec.cardType or "action"
    local mechanisms = spec.mechanisms or {}
    local value = {
        id = spec.id,
        owner = "player",
        name = spec.name,
        rarity = spec.rarity,
        description = spec.description,
        cardType = cardType,
        roles = spec.roles,
        mechanisms = mechanisms,
        base = { stealthCost = spec.cost, resistanceDamage = spec.damage },
        rules = spec.rules or { "기본 수치만 적용." },
    }

    if spec.narration ~= nil then
        value.narration = spec.narration
    elseif cardType == "plan" then
        value.narration = {
            planPlaced = { actorAction = spec.placedAction },
            planTriggered = { actorAction = spec.triggeredAction },
        }
    else
        value.narration = { play = { actorAction = spec.actorAction } }
    end

    if cardType == "plan" and spec.plan ~= nil then
        value.mechanismData = { plan = spec.plan }
    end

    if spec.resolve ~= nil then value.resolve = spec.resolve end
    if spec.canPlay ~= nil then value.canPlay = spec.canPlay end
    if spec.effectChoices ~= nil then value.effectChoices = spec.effectChoices end
    if spec.selectionPreview ~= nil then value.selectionPreview = spec.selectionPreview end

    cards[spec.id] = value
end

