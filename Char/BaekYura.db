local recoverResistance = characterCardSupport.recoverResistance
local loseStealth = characterCardSupport.loseStealth
local backlash = characterCardSupport.backlash
local cool = characterCardSupport.cool
local card = characterCardSupport.card
local planCard = characterCardSupport.planCard

local function exposureByMood(context, rejection, suspicion, ignore, confusion, compliance)
    if context.mood == "rejection" then
        return rejection
    elseif context.mood == "suspicion" then
        return suspicion
    elseif context.mood == "ignore" then
        return ignore
    elseif context.mood == "confusion" then
        return confusion
    elseif context.mood == "compliance" then
        return compliance
    end
    return ignore
end

